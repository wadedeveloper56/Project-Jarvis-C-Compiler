00000000                            invoke GetCommandLineA
00000000  E800000000        *    call GetCommandLineA
00000005  A300000000                mov cmdLinePtr, eax
                                    
                                    ; 2. Parse the command line into argc and argv array
                                    ; This is a basic space-separated parser (ignores quotes for simplicity)
0000000A  33C9                      xor ecx, ecx            ; ecx = argc counter
0000000C  8B3500000000              mov esi, cmdLinePtr     ; esi points to command line string
