struct ImportedSymbol {
	std::string publicName;
	std::string dllName;
	std::string importName;
	std::uint16_t ordinalOrHint = 0;
	std::uint8_t type = 0;
	std::uint8_t nameType = 0;
	bool byOrdinal = false;
};

ImportedSymbol parseImportObject(const Bytes& bytes, const std::string& path) {
	requireRange(bytes, 0, 20, path + " import object");
	if (readLe<std::uint16_t>(bytes, 0, path) != 0 || readLe<std::uint16_t>(bytes, 2, path) != 0xffff) {
		fail(path + ": malformed COFF import object signature");
	}
	const auto machine = readLe<std::uint16_t>(bytes, 6, path);
	if (machine != MachineAmd64) {
		fail(path + ": import library member is not AMD64");
	}
	const auto dataSize = readLe<std::uint32_t>(bytes, 12, path);
	const auto hint = readLe<std::uint16_t>(bytes, 16, path);
	const auto typeInfo = readLe<std::uint16_t>(bytes, 18, path);
	if ((typeInfo & 3) > 2 || ((typeInfo >> 2) & 7) > 4) {
		fail(path + ": unsupported COFF import-object type or name encoding");
	}
	requireRange(bytes, 20, dataSize, path + " import-object strings");
	auto readString = [&](std::size_t& offset) {
		if (offset >= 20 + dataSize) {
			fail(path + ": truncated COFF import-object strings");
		}
		const auto begin = offset;
		while (offset < 20 + dataSize && bytes[offset] != 0) {
			++offset;
		}
		if (offset == 20 + dataSize) {
			fail(path + ": unterminated COFF import-object string");
		}
		std::string value(reinterpret_cast<const char*>(bytes.data() + begin), offset - begin);
		++offset;
		return value;
	};
	std::size_t cursor = 20;
	ImportedSymbol result;
	result.publicName = readString(cursor);
	result.dllName = readString(cursor);
	result.ordinalOrHint = hint;
	result.type = static_cast<std::uint8_t>(typeInfo & 3);
	result.nameType = static_cast<std::uint8_t>((typeInfo >> 2) & 7);
	result.byOrdinal = result.nameType == 0;
	if (result.publicName.empty() || result.dllName.empty()) {
		fail(path + ": import object has an empty symbol or DLL name");
	}
	if (result.byOrdinal) {
		result.importName = result.publicName;
	} else if (result.nameType == 1) {
		result.importName = result.publicName;
	} else if (result.nameType == 2 || result.nameType == 3) {
		result.importName = result.publicName;
		if (!result.importName.empty() && (result.importName.front() == '?' || result.importName.front() == '@' || result.importName.front() == '_')) {
			result.importName.erase(result.importName.begin());
		}
		if (result.nameType == 3) {
			const auto decoration = result.importName.rfind('@');
			if (decoration != std::string::npos) {
				result.importName.erase(decoration);
			}
		}
	} else {
		result.importName = readString(cursor);
	}
	if (result.importName.empty() && !result.byOrdinal) {
		fail(path + ": import object resolves to an empty import name");
	}
	return result;
}

bool hasBitcodeMagic(const Bytes& bytes, std::size_t offset, std::size_t size) {
	if (size < 4 || offset > bytes.size() || size > bytes.size() - offset) {
		return false;
	}
	const auto* data = bytes.data() + offset;
	const bool rawBitcode = data[0] == 0x42 && data[1] == 0x43 && data[2] == 0xc0 && data[3] == 0xde;
	const bool wrappedBitcode = data[0] == 0xde && data[1] == 0xc0 && data[2] == 0x17 && data[3] == 0x0b;
	return rawBitcode || wrappedBitcode;
}

void rejectBitcode(const Bytes& bytes, std::size_t offset, std::size_t size, const std::string& inputName) {
	if (hasBitcodeMagic(bytes, offset, size)) {
		fail(inputName + ": LLVM bitcode/LTCG input is not supported; compile without LTO or provide native AMD64 COFF objects");
	}
}

std::uint32_t coffNameOffset(const Bytes& bytes, std::size_t offset) {
	if (bytes[offset] == '/' && bytes[offset + 1] != 0) {
		std::string text = fixedString(bytes, offset + 1, 7);
		std::uint32_t result = 0;
		const auto parsed = std::from_chars(text.data(), text.data() + text.size(), result);
		if (parsed.ec != std::errc{} || parsed.ptr == text.data()) {
			fail("invalid long COFF section name");
		}
		return result;
	}
	return 0;
}

std::string lowerAscii(std::string value) {
	std::transform(value.begin(), value.end(), value.begin(), [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
	return value;
}

std::uint64_t parseDirectiveNumber(std::string_view text, const std::string& objectName, std::string_view option) {
	int base = 10;
	if (text.size() > 2 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X')) {
		text.remove_prefix(2);
		base = 16;
	}
	std::uint64_t value = 0;
	const auto parsed = std::from_chars(text.data(), text.data() + text.size(), value, base);
	if (text.empty() || parsed.ec != std::errc{} || parsed.ptr != text.data() + text.size()) {
		fail(objectName + ": invalid value for .drectve " + std::string(option));
	}
	return value;
}

std::vector<std::string> tokenizeDirectives(const Bytes& bytes, const std::string& objectName) {
	std::vector<std::string> tokens;
	std::string token;
	bool quoted = false;
	for (std::size_t i = 0; i < bytes.size(); ++i) {
		const auto ch = bytes[i] == 0 ? ' ' : static_cast<char>(bytes[i]);
		if (ch == '"') {
			quoted = !quoted;
		} else if (std::isspace(static_cast<unsigned char>(ch)) && !quoted) {
			if (!token.empty()) {
				tokens.push_back(std::move(token));
				token.clear();
			}
		} else {
			token.push_back(ch);
		}
	}
	if (quoted) {
		fail(objectName + ": unterminated quote in .drectve section");
	}
	if (!token.empty()) {
		tokens.push_back(std::move(token));
	}
	return tokens;
}

bool isBigObjCandidate(const Bytes& bytes) {
	return bytes.size() >= 8 && readLe<std::uint16_t>(bytes, 0, "BigObj signature") == 0 &&
		readLe<std::uint16_t>(bytes, 2, "BigObj signature") == 0xffff &&
		readLe<std::uint16_t>(bytes, 4, "BigObj version") >= 2;
}

ObjectFile parseObject(const Bytes& bytes, std::string name) {
	requireRange(bytes, 0, 20, name);
	const bool bigObj = isBigObjCandidate(bytes);
	std::uint32_t sectionCount = 0;
	std::uint32_t symbolOffset = 0;
	std::uint32_t symbolCount = 0;
	std::size_t symbolSize = 18;
	std::size_t sectionTable = 20;
	std::uint16_t machine = 0;
	if (bigObj) {
		requireRange(bytes, 0, 56, name + " BigObj header");
		if (readLe<std::uint16_t>(bytes, 4, name) != 2 || !std::equal(BigObjClassId.begin(), BigObjClassId.end(), bytes.begin() + 12)) {
			fail(name + ": unsupported anonymous COFF object signature");
		}
		machine = readLe<std::uint16_t>(bytes, 6, name);
		sectionCount = readLe<std::uint32_t>(bytes, 44, name);
		symbolOffset = readLe<std::uint32_t>(bytes, 48, name);
		symbolCount = readLe<std::uint32_t>(bytes, 52, name);
		symbolSize = 20;
		sectionTable = 56;
	} else {
		machine = readLe<std::uint16_t>(bytes, 0, name);
		sectionCount = readLe<std::uint16_t>(bytes, 2, name);
		symbolOffset = readLe<std::uint32_t>(bytes, 8, name);
		symbolCount = readLe<std::uint32_t>(bytes, 12, name);
		sectionTable += readLe<std::uint16_t>(bytes, 16, name);
	}
	if (machine != MachineAmd64) {
		std::ostringstream message;
		message << name << ": expected AMD64 COFF object (machine 0x8664), got 0x" << std::hex << machine;
		fail(message.str());
	}
	if (sectionCount > (std::numeric_limits<std::size_t>::max() - sectionTable) / 40) {
		fail(name + ": section table is too large");
	}
	requireRange(bytes, sectionTable, static_cast<std::size_t>(sectionCount) * 40, name + " section table");

	std::size_t stringTableOffset = 0;
	std::uint32_t stringTableSize = 0;
	if (symbolCount != 0) {
		if (symbolOffset == 0) {
			fail(name + ": missing COFF symbol table");
		}
		if (symbolCount > std::numeric_limits<std::size_t>::max() / symbolSize) {
			fail(name + ": symbol table is too large");
		}
		const auto symbolsBytes = static_cast<std::size_t>(symbolCount) * symbolSize;
		requireRange(bytes, symbolOffset, symbolsBytes, name + " symbol table");
		stringTableOffset = static_cast<std::size_t>(symbolOffset) + symbolsBytes;
		requireRange(bytes, stringTableOffset, 4, name + " string table");
		stringTableSize = readLe<std::uint32_t>(bytes, stringTableOffset, name + " string table");
		if (stringTableSize < 4) {
			fail(name + ": invalid COFF string table size");
		}
		requireRange(bytes, stringTableOffset, stringTableSize, name + " string table");
	}

	ObjectFile object;
	object.name = std::move(name);
	object.sections.reserve(sectionCount);
	for (std::uint32_t i = 0; i < sectionCount; ++i) {
		const auto header = sectionTable + static_cast<std::size_t>(i) * 40;
		const auto nameOffset = coffNameOffset(bytes, header);
		std::string sectionName = fixedString(bytes, header, 8);
		if (nameOffset != 0) {
			if (stringTableSize == 0) {
				fail(object.name + ": long section name without a COFF string table");
			}
			sectionName = stringAt(bytes, stringTableOffset, stringTableSize, nameOffset, "section");
		}
		if (sectionName.empty()) {
			fail(object.name + ": section with an empty name");
		}
		const auto normalizedSectionName = lowerAscii(sectionName);
		if (normalizedSectionName == ".llvmbc" || normalizedSectionName == ".llvm.lto" || normalizedSectionName.rfind(".lto$", 0) == 0) {
			fail(object.name + ": LLVM bitcode/LTCG section '" + sectionName + "' is not supported; compile without LTO or provide native AMD64 COFF objects");
		}
		InputSection section;
		section.codeViewTypes = normalizedSectionName == ".debug$t";
		section.codeViewSymbols = normalizedSectionName == ".debug$s";
		section.name = std::move(sectionName);
		section.linkerDirective = section.name == ".drectve";
		section.virtualSize = readLe<std::uint32_t>(bytes, header + 8, object.name);
		const auto rawSize = readLe<std::uint32_t>(bytes, header + 16, object.name);
		const auto rawOffset = readLe<std::uint32_t>(bytes, header + 20, object.name);
		const auto relocationOffset = readLe<std::uint32_t>(bytes, header + 24, object.name);
		const auto relocationCount = readLe<std::uint16_t>(bytes, header + 32, object.name);
		section.characteristics = readLe<std::uint32_t>(bytes, header + 36, object.name);
		const auto alignmentCode = (section.characteristics >> 20) & 0x0f;
		if (alignmentCode > 14) {
			fail(object.name + ": unsupported section alignment");
		}
		section.alignment = alignmentCode == 0 ? 1u : (1u << (alignmentCode - 1));
		if (rawSize != 0) {
			requireRange(bytes, rawOffset, rawSize, object.name + " section data");
			section.data.assign(bytes.begin() + rawOffset, bytes.begin() + rawOffset + rawSize);
		}
		if (relocationCount == 0xffff) {
			fail(object.name + ": extended COFF relocation tables are not supported");
		}
		if (relocationCount != 0) {
			requireRange(bytes, relocationOffset, static_cast<std::size_t>(relocationCount) * 10, object.name + " relocation table");
			section.relocations.reserve(relocationCount);
			for (std::uint16_t r = 0; r < relocationCount; ++r) {
				const auto entry = static_cast<std::size_t>(relocationOffset) + static_cast<std::size_t>(r) * 10;
				section.relocations.push_back({
					readLe<std::uint32_t>(bytes, entry, object.name),
					readLe<std::uint32_t>(bytes, entry + 4, object.name),
					readLe<std::uint16_t>(bytes, entry + 8, object.name)
				});
			}
		}
		if (section.virtualSize < rawSize) {
			section.virtualSize = rawSize;
		}
		if (section.linkerDirective) {
			auto directives = tokenizeDirectives(section.data, object.name);
			object.directives.insert(object.directives.end(), std::make_move_iterator(directives.begin()), std::make_move_iterator(directives.end()));
		}
		object.sections.push_back(std::move(section));
	}

	object.symbols.resize(symbolCount);
	for (std::uint32_t i = 0; i < symbolCount;) {
		const auto entry = static_cast<std::size_t>(symbolOffset) + static_cast<std::size_t>(i) * symbolSize;
		const auto nameZeroes = readLe<std::uint32_t>(bytes, entry, object.name);
		const auto nameOffset = readLe<std::uint32_t>(bytes, entry + 4, object.name);
		auto& symbol = object.symbols[i];
		if (nameZeroes == 0) {
			if (stringTableSize == 0) {
				fail(object.name + ": symbol uses a missing COFF string table");
			}
			symbol.name = stringAt(bytes, stringTableOffset, stringTableSize, nameOffset, "symbol");
		} else {
			symbol.name = fixedString(bytes, entry, 8);
		}
		symbol.value = readLe<std::uint32_t>(bytes, entry + 8, object.name);
		symbol.sectionNumber = bigObj
			? static_cast<std::int32_t>(readLe<std::uint32_t>(bytes, entry + 12, object.name))
			: static_cast<std::int16_t>(readLe<std::uint16_t>(bytes, entry + 12, object.name));
		const auto storageClassOffset = bigObj ? 18u : 16u;
		const auto auxiliaryCountOffset = bigObj ? 19u : 17u;
		symbol.storageClass = bytes[entry + storageClassOffset];
		const auto auxiliaryCount = bytes[entry + auxiliaryCountOffset];
		if (auxiliaryCount > symbolCount - i - 1) {
			fail(object.name + ": invalid COFF auxiliary symbol count");
		}
		if (auxiliaryCount != 0) {
			const auto auxiliary = entry + symbolSize;
			if (symbol.storageClass == 105 && symbol.sectionNumber == 0) {
				symbol.weakTagIndex = readLe<std::uint32_t>(bytes, auxiliary, object.name);
				symbol.weakCharacteristics = readLe<std::uint32_t>(bytes, auxiliary + 4, object.name);
			} else if (symbol.storageClass == 3 && symbol.sectionNumber > 0) {
				if (static_cast<std::size_t>(symbol.sectionNumber) > object.sections.size()) {
					fail(object.name + ": section symbol refers to an invalid section");
				}
				auto& section = object.sections.at(static_cast<std::size_t>(symbol.sectionNumber - 1));
				if ((section.characteristics & 0x00001000) != 0) {
					if (bigObj) {
						section.comdatSelection = bytes[auxiliary + 16];
						section.associatedSection = readLe<std::uint16_t>(bytes, auxiliary + 12, object.name) |
							(static_cast<std::uint32_t>(readLe<std::uint16_t>(bytes, auxiliary + 18, object.name)) << 16);
					} else {
						section.comdatSelection = bytes[auxiliary + 14];
						section.associatedSection = readLe<std::uint16_t>(bytes, auxiliary + 12, object.name);
					}
				}
			}
		}
		for (std::uint32_t aux = 1; aux <= auxiliaryCount; ++aux) {
			object.symbols[i + aux].auxiliary = true;
		}
		i += static_cast<std::uint32_t>(auxiliaryCount) + 1;
	}
	for (const auto& symbol : object.symbols) {
		if (!symbol.auxiliary && symbol.storageClass == 2 && symbol.sectionNumber > 0 && static_cast<std::size_t>(symbol.sectionNumber) <= object.sections.size()) {
			auto& section = object.sections[static_cast<std::size_t>(symbol.sectionNumber - 1)];
			if (section.comdatSelection != 0 && section.comdatKey.empty()) {
				section.comdatKey = symbol.name;
			}
		}
	}
	for (const auto& section : object.sections) {
		if (section.comdatSelection > 7) {
			fail(object.name + ": unsupported COMDAT selection type");
		}
		if (section.comdatSelection != 0 && section.comdatSelection != 5 && section.comdatKey.empty()) {
			fail(object.name + ": COMDAT section has no external selection key");
		}
	}
	for (const auto& section : object.sections) {
		for (const auto& relocation : section.relocations) {
			if (relocation.symbolIndex >= object.symbols.size() || object.symbols[relocation.symbolIndex].auxiliary) {
				fail(object.name + ": relocation refers to an invalid COFF symbol");
			}
		}
	}
	return object;
}

struct ArchiveMember {
	std::string name;
	std::optional<ObjectFile> object;
	std::optional<ImportedSymbol> imported;
	bool selected = false;
};

struct Archive {
	std::vector<ArchiveMember> members;
	std::unordered_map<std::string, std::vector<std::size_t>> symbolMembers;
	bool hasSymbolIndex = false;
};

struct PendingArchiveSymbol {
	std::string name;
	std::uint64_t memberOffset = 0;
};

std::size_t parseDecimal(const Bytes& bytes, std::size_t offset, std::size_t length, std::string_view what) {
	const auto text = fixedString(bytes, offset, length);
	const auto first = text.find_first_not_of(' ');
	if (first == std::string::npos) {
		return 0;
	}
	auto last = text.find_last_not_of(' ');
	std::size_t value = 0;
	const auto parsed = std::from_chars(text.data() + first, text.data() + last + 1, value);
	if (parsed.ec != std::errc{} || parsed.ptr != text.data() + last + 1) {
		fail("invalid archive " + std::string(what));
	}
	return value;
}

std::uint32_t readBigEndian32(const Bytes& bytes, std::size_t offset, std::string_view what) {
	requireRange(bytes, offset, 4, what);
	return (static_cast<std::uint32_t>(bytes[offset]) << 24) |
		(static_cast<std::uint32_t>(bytes[offset + 1]) << 16) |
		(static_cast<std::uint32_t>(bytes[offset + 2]) << 8) |
		static_cast<std::uint32_t>(bytes[offset + 3]);
}

std::uint64_t readBigEndian64(const Bytes& bytes, std::size_t offset, std::string_view what) {
	requireRange(bytes, offset, 8, what);
	std::uint64_t value = 0;
	for (std::size_t i = 0; i < 8; ++i) {
		value = (value << 8) | bytes[offset + i];
	}
	return value;
}

std::vector<PendingArchiveSymbol> parseFirstLinkerMember(const Bytes& bytes, std::size_t offset, std::size_t size, const std::string& path) {
	requireRange(bytes, offset, size, path + " first linker member");
	if (size < 4) {
		fail(path + ": truncated first archive linker member");
	}
	const auto count = readBigEndian32(bytes, offset, path + " first archive linker member");
	if (count > (size - 4) / 4) {
		fail(path + ": invalid first archive linker-member symbol count");
	}
	const auto namesOffset = offset + 4 + static_cast<std::size_t>(count) * 4;
	const auto namesEnd = offset + size;
	std::vector<PendingArchiveSymbol> symbols;
	symbols.reserve(count);
	std::size_t cursor = namesOffset;
	for (std::uint32_t i = 0; i < count; ++i) {
		if (cursor >= namesEnd) {
			fail(path + ": truncated first archive linker-member names");
		}
		const auto end = std::find(bytes.begin() + cursor, bytes.begin() + namesEnd, 0);
		if (end == bytes.begin() + namesEnd) {
			fail(path + ": unterminated first archive linker-member name");
		}
		const auto nameEnd = static_cast<std::size_t>(end - bytes.begin());
		const std::string name(reinterpret_cast<const char*>(bytes.data() + cursor), nameEnd - cursor);
		const auto memberOffset = readBigEndian32(bytes, offset + 4 + static_cast<std::size_t>(i) * 4, path + " first archive linker member");
		if (name.empty() || memberOffset < 8) {
			fail(path + ": invalid first archive linker-member entry");
		}
		symbols.push_back({name, memberOffset});
		cursor = nameEnd + 1;
	}
	return symbols;
}

std::vector<PendingArchiveSymbol> parseSecondLinkerMember(const Bytes& bytes, std::size_t offset, std::size_t size, const std::string& path) {
	requireRange(bytes, offset, size, path + " second linker member");
	if (size < 4) {
		fail(path + ": truncated second archive linker member");
	}
	const auto memberCount = readLe<std::uint32_t>(bytes, offset, path + " second archive linker member");
	if (memberCount > (size - 4) / 4) {
		fail(path + ": invalid second archive linker-member member count");
	}
	const auto symbolCountOffset = offset + 4 + static_cast<std::size_t>(memberCount) * 4;
	requireRange(bytes, symbolCountOffset, 4, path + " second archive linker member");
	const auto symbolCount = readLe<std::uint32_t>(bytes, symbolCountOffset, path + " second archive linker member");
	const auto indicesOffset = symbolCountOffset + 4;
	if (symbolCount > (offset + size - indicesOffset) / 2) {
		fail(path + ": invalid second archive linker-member symbol count");
	}
	const auto namesOffset = indicesOffset + static_cast<std::size_t>(symbolCount) * 2;
	const auto namesEnd = offset + size;
	std::vector<PendingArchiveSymbol> symbols;
	symbols.reserve(symbolCount);
	std::size_t cursor = namesOffset;
	for (std::uint32_t i = 0; i < symbolCount; ++i) {
		const auto memberIndex = readLe<std::uint16_t>(bytes, indicesOffset + static_cast<std::size_t>(i) * 2, path + " second archive linker member");
		if (memberIndex == 0 || memberIndex > memberCount || cursor >= namesEnd) {
			fail(path + ": invalid second archive linker-member symbol entry");
		}
		const auto end = std::find(bytes.begin() + cursor, bytes.begin() + namesEnd, 0);
		if (end == bytes.begin() + namesEnd) {
			fail(path + ": unterminated second archive linker-member name");
		}
		const auto nameEnd = static_cast<std::size_t>(end - bytes.begin());
		const std::string name(reinterpret_cast<const char*>(bytes.data() + cursor), nameEnd - cursor);
		const auto memberOffset = readLe<std::uint32_t>(bytes, offset + 4 + static_cast<std::size_t>(memberIndex - 1) * 4, path + " second archive linker member");
		if (name.empty() || memberOffset < 8) {
			fail(path + ": invalid second archive linker-member entry");
		}
		symbols.push_back({name, memberOffset});
		cursor = nameEnd + 1;
	}
	return symbols;
}

std::vector<PendingArchiveSymbol> parseSym64LinkerMember(const Bytes& bytes, std::size_t offset, std::size_t size, const std::string& path) {
	requireRange(bytes, offset, size, path + " 64-bit linker member");
	if (size < 8) {
		fail(path + ": truncated 64-bit archive linker member");
	}
	const auto count = readBigEndian64(bytes, offset, path + " 64-bit archive linker member");
	if (count > (size - 8) / 8) {
		fail(path + ": invalid 64-bit archive linker-member symbol count");
	}
	const auto namesOffset = offset + 8 + static_cast<std::size_t>(count) * 8;
	const auto namesEnd = offset + size;
	std::vector<PendingArchiveSymbol> symbols;
	symbols.reserve(static_cast<std::size_t>(count));
	std::size_t cursor = namesOffset;
	for (std::uint64_t i = 0; i < count; ++i) {
		if (cursor >= namesEnd) {
			fail(path + ": truncated 64-bit archive linker-member names");
		}
		const auto end = std::find(bytes.begin() + cursor, bytes.begin() + namesEnd, 0);
		if (end == bytes.begin() + namesEnd) {
			fail(path + ": unterminated 64-bit archive linker-member name");
		}
		const auto nameEnd = static_cast<std::size_t>(end - bytes.begin());
		const std::string name(reinterpret_cast<const char*>(bytes.data() + cursor), nameEnd - cursor);
		const auto memberOffset = readBigEndian64(bytes, offset + 8 + static_cast<std::size_t>(i) * 8, path + " 64-bit archive linker member");
		if (name.empty() || memberOffset < 8) {
			fail(path + ": invalid 64-bit archive linker-member entry");
		}
		symbols.push_back({name, memberOffset});
		cursor = nameEnd + 1;
	}
	return symbols;
}

Archive parseArchive(const Bytes& bytes, const std::string& path) {
	constexpr std::string_view magic = "!<arch>\n";
	if (bytes.size() < magic.size() || !std::equal(magic.begin(), magic.end(), bytes.begin())) {
		fail(path + ": not a Microsoft COFF library archive");
	}
	Archive archive;
	std::vector<PendingArchiveSymbol> pendingSymbols;
	std::unordered_map<std::size_t, std::size_t> memberByOffset;
	std::string longNames;
	std::size_t linkerMemberCount = 0;
	std::size_t position = magic.size();
	while (position < bytes.size()) {
		requireRange(bytes, position, 60, path + " archive member header");
		if (bytes[position + 58] != '`' || bytes[position + 59] != '\n') {
			fail(path + ": malformed archive member header");
		}
		const auto memberSize = parseDecimal(bytes, position + 48, 10, "member size");
		const auto dataOffset = position + 60;
		requireRange(bytes, dataOffset, memberSize, path + " archive member");
		auto rawName = fixedString(bytes, position, 16);
		while (!rawName.empty() && rawName.back() == ' ') {
			rawName.pop_back();
		}
		std::string memberName = rawName;
		if (memberName == "//") {
			longNames.assign(reinterpret_cast<const char*>(bytes.data() + dataOffset), memberSize);
		} else if (memberName == "/") {
			archive.hasSymbolIndex = true;
			if (linkerMemberCount++ == 0) {
				auto symbols = parseFirstLinkerMember(bytes, dataOffset, memberSize, path);
				pendingSymbols.insert(pendingSymbols.end(), std::make_move_iterator(symbols.begin()), std::make_move_iterator(symbols.end()));
			} else if (linkerMemberCount == 2) {
				auto symbols = parseSecondLinkerMember(bytes, dataOffset, memberSize, path);
				pendingSymbols.insert(pendingSymbols.end(), std::make_move_iterator(symbols.begin()), std::make_move_iterator(symbols.end()));
			} else {
				fail(path + ": archive contains more than two Microsoft linker members");
			}
		} else if (memberName == "/SYM64/") {
			archive.hasSymbolIndex = true;
			auto symbols = parseSym64LinkerMember(bytes, dataOffset, memberSize, path);
			pendingSymbols.insert(pendingSymbols.end(), std::make_move_iterator(symbols.begin()), std::make_move_iterator(symbols.end()));
		} else {
			if (memberName.size() > 1 && memberName[0] == '/' && std::isdigit(static_cast<unsigned char>(memberName[1]))) {
				std::size_t nameOffset = 0;
				const auto parsed = std::from_chars(memberName.data() + 1, memberName.data() + memberName.size(), nameOffset);
				if (parsed.ec != std::errc{} || nameOffset >= longNames.size()) {
					fail(path + ": invalid archive long-name offset");
				}
				const auto end = longNames.find("/\n", nameOffset);
				memberName = longNames.substr(nameOffset, end == std::string::npos ? std::string::npos : end - nameOffset);
			} else if (memberName.size() > 1 && memberName.back() == '/') {
				memberName.pop_back();
			}
			ArchiveMember member;
			member.name = memberName;
			rejectBitcode(bytes, dataOffset, memberSize, path + "(" + memberName + ")");
			if (memberSize >= 20) {
				const auto machine = readLe<std::uint16_t>(bytes, dataOffset, path);
				const auto signature = readLe<std::uint16_t>(bytes, dataOffset + 2, path);
				const auto anonymousVersion = memberSize >= 6 ? readLe<std::uint16_t>(bytes, dataOffset + 4, path) : 0;
				if (signature == 0xffff && anonymousVersion >= 2) {
					Bytes objectBytes(bytes.begin() + dataOffset, bytes.begin() + dataOffset + memberSize);
					member.object = parseObject(objectBytes, path + "(" + memberName + ")");
				} else if (machine == 0 && signature == 0xffff) {
					Bytes importBytes(bytes.begin() + dataOffset, bytes.begin() + dataOffset + memberSize);
					member.imported = parseImportObject(importBytes, path + "(" + memberName + ")");
				} else if (machine == MachineAmd64) {
					Bytes objectBytes(bytes.begin() + dataOffset, bytes.begin() + dataOffset + memberSize);
					member.object = parseObject(objectBytes, path + "(" + memberName + ")");
				}
			}
			memberByOffset.emplace(position, archive.members.size());
			archive.members.push_back(std::move(member));
		}
		position = dataOffset + memberSize;
		if ((position & 1) != 0) {
			++position;
		}
	}
	if (position != bytes.size()) {
		fail(path + ": archive ends with an incomplete member");
	}
	for (const auto& symbol : pendingSymbols) {
		if (symbol.memberOffset > std::numeric_limits<std::size_t>::max()) {
			fail(path + ": archive linker member references an invalid object-member offset");
		}
		const auto member = memberByOffset.find(static_cast<std::size_t>(symbol.memberOffset));
		if (member == memberByOffset.end()) {
			fail(path + ": archive linker member references an invalid object-member offset");
		}
		archive.symbolMembers[symbol.name].push_back(member->second);
	}
	return archive;
}

Bytes readFile(const fs::path& path) {
	std::ifstream input(path, std::ios::binary);
	if (!input) {
		fail("cannot open '" + path.string() + "'");
	}
	input.seekg(0, std::ios::end);
	const auto length = input.tellg();
	if (length < 0 || static_cast<std::uint64_t>(length) > std::numeric_limits<std::size_t>::max()) {
		fail("cannot determine file size for '" + path.string() + "'");
	}
	Bytes bytes(static_cast<std::size_t>(length));
	input.seekg(0, std::ios::beg);
	if (!bytes.empty() && !input.read(reinterpret_cast<char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()))) {
		fail("failed reading '" + path.string() + "'");
	}
	return bytes;
}

