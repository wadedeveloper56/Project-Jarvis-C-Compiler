namespace fs = std::filesystem;
using Bytes = std::vector<std::uint8_t>;

namespace {
constexpr std::uint16_t MachineAmd64 = 0x8664;
constexpr std::uint32_t SectionCntCode = 0x00000020;
constexpr std::uint32_t SectionCntUninitializedData = 0x00000080;
constexpr std::uint32_t SectionMemExecute = 0x20000000;
constexpr std::uint32_t SectionMemRead = 0x40000000;
constexpr std::uint32_t SectionMemWrite = 0x80000000;
constexpr std::uint64_t ImageBase = 0x140000000ULL;
constexpr std::uint32_t SectionAlignment = 0x1000;
constexpr std::uint32_t FileAlignment = 0x200;

[[noreturn]] void fail(const std::string& message) {
	throw std::runtime_error(message);
}

void requireRange(const Bytes& bytes, std::size_t offset, std::size_t size, std::string_view what) {
	if (offset > bytes.size() || size > bytes.size() - offset) {
		fail("truncated " + std::string(what));
	}
}

template <typename T>
T readLe(const Bytes& bytes, std::size_t offset, std::string_view what) {
	static_assert(std::is_unsigned_v<T>);
	requireRange(bytes, offset, sizeof(T), what);
	std::uint64_t value = 0;
	for (std::size_t i = 0; i < sizeof(T); ++i) {
		value |= static_cast<std::uint64_t>(bytes[offset + i]) << (i * 8);
	}
	return static_cast<T>(value);
}

template <typename T>
void writeLe(Bytes& bytes, std::size_t offset, T value) {
	static_assert(std::is_unsigned_v<T>);
	if (offset > bytes.size() || sizeof(T) > bytes.size() - offset) {
		fail("internal PE layout error");
	}
	for (std::size_t i = 0; i < sizeof(T); ++i) {
		bytes[offset + i] = static_cast<std::uint8_t>(value >> (i * 8));
	}
}

std::size_t alignUp(std::size_t value, std::size_t alignment) {
	if (alignment == 0 || (alignment & (alignment - 1)) != 0) {
		fail("invalid alignment in input object");
	}
	const auto remainder = value & (alignment - 1);
	if (remainder == 0) {
		return value;
	}
	const auto padding = alignment - remainder;
	if (value > std::numeric_limits<std::size_t>::max() - padding) {
		fail("input is too large");
	}
	return value + padding;
}

std::uint32_t toU32(std::size_t value, std::string_view what) {
	if (value > std::numeric_limits<std::uint32_t>::max()) {
		fail(std::string(what) + " exceeds the PE32+ size limit");
	}
	return static_cast<std::uint32_t>(value);
}

std::string fixedString(const Bytes& bytes, std::size_t offset, std::size_t length) {
	requireRange(bytes, offset, length, "string field");
	std::size_t end = offset;
	while (end < offset + length && bytes[end] != 0) {
		++end;
	}
	return std::string(reinterpret_cast<const char*>(bytes.data() + offset), end - offset);
}

std::string stringAt(const Bytes& bytes, std::size_t tableOffset, std::uint32_t tableSize, std::uint32_t stringOffset, std::string_view what) {
	if (stringOffset < 4 || stringOffset >= tableSize) {
		fail("invalid " + std::string(what) + " string-table offset");
	}
	const auto start = tableOffset + stringOffset;
	requireRange(bytes, start, tableSize - stringOffset, what);
	auto end = start;
	while (end < tableOffset + tableSize && bytes[end] != 0) {
		++end;
	}
	if (end == tableOffset + tableSize) {
		fail("unterminated " + std::string(what) + " string");
	}
	return std::string(reinterpret_cast<const char*>(bytes.data() + start), end - start);
}

struct Relocation {
	std::uint32_t offset = 0;
	std::uint32_t symbolIndex = 0;
	std::uint16_t type = 0;
};

struct InputSection {
	std::string name;
	std::uint32_t virtualSize = 0;
	std::uint32_t characteristics = 0;
	std::uint32_t alignment = 1;
	Bytes data;
	std::vector<Relocation> relocations;
};

struct CoffSymbol {
	std::string name;
	std::uint32_t value = 0;
	std::int16_t sectionNumber = 0;
	std::uint8_t storageClass = 0;
	bool auxiliary = false;
};

struct ObjectFile {
	std::string name;
	std::vector<InputSection> sections;
	std::vector<CoffSymbol> symbols;
};

std::uint32_t coffNameOffset(const Bytes& bytes, std::size_t offset) {
	if (bytes[offset] == '/' && bytes[offset + 1] != 0) {
		std::string text = fixedString(bytes, offset + 1, 7);
		std::uint32_t result = 0;
		const auto parsed = std::from_chars(text.data(), text.data() + text.size(), result);
		if (parsed.ec != std::errc{} || parsed.ptr == text.data()) {
			fail("invalid long COFF section name");
		}
		return result;
	}
	return 0;
}

ObjectFile parseObject(const Bytes& bytes, std::string name) {
	requireRange(bytes, 0, 20, name);
	const auto machine = readLe<std::uint16_t>(bytes, 0, name);
	if (machine != MachineAmd64) {
		std::ostringstream message;
		message << name << ": expected AMD64 COFF object (machine 0x8664), got 0x" << std::hex << machine;
		fail(message.str());
	}
	const auto sectionCount = readLe<std::uint16_t>(bytes, 2, name);
	const auto symbolOffset = readLe<std::uint32_t>(bytes, 8, name);
	const auto symbolCount = readLe<std::uint32_t>(bytes, 12, name);
	const auto optionalSize = readLe<std::uint16_t>(bytes, 16, name);
	const std::size_t sectionTable = 20u + optionalSize;
	requireRange(bytes, sectionTable, static_cast<std::size_t>(sectionCount) * 40, name + " section table");

	std::size_t stringTableOffset = 0;
	std::uint32_t stringTableSize = 0;
	if (symbolCount != 0) {
		if (symbolOffset == 0) {
			fail(name + ": missing COFF symbol table");
		}
		const auto symbolsBytes = static_cast<std::size_t>(symbolCount) * 18;
		requireRange(bytes, symbolOffset, symbolsBytes, name + " symbol table");
		stringTableOffset = static_cast<std::size_t>(symbolOffset) + symbolsBytes;
		requireRange(bytes, stringTableOffset, 4, name + " string table");
		stringTableSize = readLe<std::uint32_t>(bytes, stringTableOffset, name + " string table");
		if (stringTableSize < 4) {
			fail(name + ": invalid COFF string table size");
		}
		requireRange(bytes, stringTableOffset, stringTableSize, name + " string table");
	}

	ObjectFile object;
	object.name = std::move(name);
	object.sections.reserve(sectionCount);
	for (std::uint16_t i = 0; i < sectionCount; ++i) {
		const auto header = sectionTable + static_cast<std::size_t>(i) * 40;
		const auto nameOffset = coffNameOffset(bytes, header);
		std::string sectionName = fixedString(bytes, header, 8);
		if (nameOffset != 0) {
			if (stringTableSize == 0) {
				fail(object.name + ": long section name without a COFF string table");
			}
			sectionName = stringAt(bytes, stringTableOffset, stringTableSize, nameOffset, "section");
		}
		if (sectionName.empty()) {
			fail(object.name + ": section with an empty name");
		}
		InputSection section;
		section.name = std::move(sectionName);
		section.virtualSize = readLe<std::uint32_t>(bytes, header + 8, object.name);
		const auto rawSize = readLe<std::uint32_t>(bytes, header + 16, object.name);
		const auto rawOffset = readLe<std::uint32_t>(bytes, header + 20, object.name);
		const auto relocationOffset = readLe<std::uint32_t>(bytes, header + 24, object.name);
		const auto relocationCount = readLe<std::uint16_t>(bytes, header + 32, object.name);
		section.characteristics = readLe<std::uint32_t>(bytes, header + 36, object.name);
		const auto alignmentCode = (section.characteristics >> 20) & 0x0f;
		if (alignmentCode > 14) {
			fail(object.name + ": unsupported section alignment");
		}
		section.alignment = alignmentCode == 0 ? 1u : (1u << (alignmentCode - 1));
		if (rawSize != 0) {
			requireRange(bytes, rawOffset, rawSize, object.name + " section data");
			section.data.assign(bytes.begin() + rawOffset, bytes.begin() + rawOffset + rawSize);
		}
		if (relocationCount == 0xffff) {
			fail(object.name + ": extended COFF relocation tables are not supported");
		}
		if (relocationCount != 0) {
			requireRange(bytes, relocationOffset, static_cast<std::size_t>(relocationCount) * 10, object.name + " relocation table");
			section.relocations.reserve(relocationCount);
			for (std::uint16_t r = 0; r < relocationCount; ++r) {
				const auto entry = static_cast<std::size_t>(relocationOffset) + static_cast<std::size_t>(r) * 10;
				section.relocations.push_back({
					readLe<std::uint32_t>(bytes, entry, object.name),
					readLe<std::uint32_t>(bytes, entry + 4, object.name),
					readLe<std::uint16_t>(bytes, entry + 8, object.name)
				});
			}
		}
		if (section.virtualSize < rawSize) {
			section.virtualSize = rawSize;
		}
		object.sections.push_back(std::move(section));
	}

	object.symbols.resize(symbolCount);
	for (std::uint32_t i = 0; i < symbolCount;) {
		const auto entry = static_cast<std::size_t>(symbolOffset) + static_cast<std::size_t>(i) * 18;
		const auto nameZeroes = readLe<std::uint32_t>(bytes, entry, object.name);
		const auto nameOffset = readLe<std::uint32_t>(bytes, entry + 4, object.name);
		auto& symbol = object.symbols[i];
		if (nameZeroes == 0) {
			if (stringTableSize == 0) {
				fail(object.name + ": symbol uses a missing COFF string table");
			}
			symbol.name = stringAt(bytes, stringTableOffset, stringTableSize, nameOffset, "symbol");
		} else {
			symbol.name = fixedString(bytes, entry, 8);
		}
		symbol.value = readLe<std::uint32_t>(bytes, entry + 8, object.name);
		symbol.sectionNumber = static_cast<std::int16_t>(readLe<std::uint16_t>(bytes, entry + 12, object.name));
		symbol.storageClass = bytes[entry + 16];
		const auto auxiliaryCount = bytes[entry + 17];
		if (auxiliaryCount > symbolCount - i - 1) {
			fail(object.name + ": invalid COFF auxiliary symbol count");
		}
		for (std::uint32_t aux = 1; aux <= auxiliaryCount; ++aux) {
			object.symbols[i + aux].auxiliary = true;
		}
		i += static_cast<std::uint32_t>(auxiliaryCount) + 1;
	}
	for (const auto& section : object.sections) {
		for (const auto& relocation : section.relocations) {
			if (relocation.symbolIndex >= object.symbols.size() || object.symbols[relocation.symbolIndex].auxiliary) {
				fail(object.name + ": relocation refers to an invalid COFF symbol");
			}
		}
	}
	return object;
}

struct ArchiveMember {
	std::string name;
	std::optional<ObjectFile> object;
	bool importObject = false;
	bool selected = false;
};

std::size_t parseDecimal(const Bytes& bytes, std::size_t offset, std::size_t length, std::string_view what) {
	const auto text = fixedString(bytes, offset, length);
	const auto first = text.find_first_not_of(' ');
	if (first == std::string::npos) {
		return 0;
	}
	auto last = text.find_last_not_of(' ');
	std::size_t value = 0;
	const auto parsed = std::from_chars(text.data() + first, text.data() + last + 1, value);
	if (parsed.ec != std::errc{} || parsed.ptr != text.data() + last + 1) {
		fail("invalid archive " + std::string(what));
	}
	return value;
}

std::vector<ArchiveMember> parseArchive(const Bytes& bytes, const std::string& path) {
	constexpr std::string_view magic = "!<arch>\n";
	if (bytes.size() < magic.size() || !std::equal(magic.begin(), magic.end(), bytes.begin())) {
		fail(path + ": not a Microsoft COFF library archive");
	}
	std::vector<ArchiveMember> members;
	std::string longNames;
	std::size_t position = magic.size();
	while (position < bytes.size()) {
		requireRange(bytes, position, 60, path + " archive member header");
		if (bytes[position + 58] != '`' || bytes[position + 59] != '\n') {
			fail(path + ": malformed archive member header");
		}
		const auto memberSize = parseDecimal(bytes, position + 48, 10, "member size");
		const auto dataOffset = position + 60;
		requireRange(bytes, dataOffset, memberSize, path + " archive member");
		auto rawName = fixedString(bytes, position, 16);
		while (!rawName.empty() && rawName.back() == ' ') {
			rawName.pop_back();
		}
		std::string memberName = rawName;
		if (memberName == "//") {
			longNames.assign(reinterpret_cast<const char*>(bytes.data() + dataOffset), memberSize);
		} else if (memberName != "/" && memberName != "/SYM64/") {
			if (memberName.size() > 1 && memberName[0] == '/' && std::isdigit(static_cast<unsigned char>(memberName[1]))) {
				std::size_t nameOffset = 0;
				const auto parsed = std::from_chars(memberName.data() + 1, memberName.data() + memberName.size(), nameOffset);
				if (parsed.ec != std::errc{} || nameOffset >= longNames.size()) {
					fail(path + ": invalid archive long-name offset");
				}
				const auto end = longNames.find("/\n", nameOffset);
				memberName = longNames.substr(nameOffset, end == std::string::npos ? std::string::npos : end - nameOffset);
			} else if (memberName.size() > 1 && memberName.back() == '/') {
				memberName.pop_back();
			}
			ArchiveMember member;
			member.name = memberName;
			if (memberSize >= 20) {
				const auto machine = readLe<std::uint16_t>(bytes, dataOffset, path);
				const auto signature = readLe<std::uint16_t>(bytes, dataOffset + 2, path);
				if (machine == 0 && signature == 0xffff) {
					member.importObject = true;
				} else if (machine == MachineAmd64 || machine == 0x014c) {
					Bytes objectBytes(bytes.begin() + dataOffset, bytes.begin() + dataOffset + memberSize);
					member.object = parseObject(objectBytes, path + "(" + memberName + ")");
				}
			}
			members.push_back(std::move(member));
		}
		position = dataOffset + memberSize;
		if ((position & 1) != 0) {
			++position;
		}
	}
	if (position != bytes.size()) {
		fail(path + ": archive ends with an incomplete member");
	}
	return members;
}

Bytes readFile(const fs::path& path) {
	std::ifstream input(path, std::ios::binary);
	if (!input) {
		fail("cannot open '" + path.string() + "'");
	}
	input.seekg(0, std::ios::end);
	const auto length = input.tellg();
	if (length < 0 || static_cast<std::uint64_t>(length) > std::numeric_limits<std::size_t>::max()) {
		fail("cannot determine file size for '" + path.string() + "'");
	}
	Bytes bytes(static_cast<std::size_t>(length));
	input.seekg(0, std::ios::beg);
	if (!bytes.empty() && !input.read(reinterpret_cast<char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()))) {
		fail("failed reading '" + path.string() + "'");
	}
	return bytes;
}

struct OutputSection {
	std::string name;
	Bytes data;
	std::size_t virtualSize = 0;
	std::size_t alignment = 1;
	std::uint32_t characteristics = 0;
	std::uint32_t rva = 0;
	std::uint32_t rawOffset = 0;
	std::uint32_t rawSize = 0;
};

struct SectionMap {
	std::size_t outputIndex = 0;
	std::size_t offset = 0;
};

struct GlobalSymbol {
	std::size_t objectIndex = 0;
	std::size_t symbolIndex = 0;
	bool common = false;
	std::size_t commonSize = 0;
	std::size_t outputIndex = 0;
	std::size_t outputOffset = 0;
};

struct LinkOptions {
	fs::path output = "a.exe";
	std::optional<std::string> entry;
	std::uint16_t subsystem = 3;
	std::vector<fs::path> inputs;
};

class Linker {
public:
	explicit Linker(LinkOptions options) : options_(std::move(options)) {}

	void run() {
		loadInputs();
		resolveLibraries();
		validateUnresolvedSymbols();
		buildSections();
		resolveGlobals();
		layoutImage();
		applyRelocations();
		writeImage();
	}

private:
	LinkOptions options_;
	std::vector<ObjectFile> objects_;
	std::vector<std::vector<ArchiveMember>> archives_;
	std::vector<OutputSection> outputSections_;
	std::vector<std::vector<SectionMap>> sectionMaps_;
	std::unordered_map<std::string, GlobalSymbol> globals_;
	bool hasImportObjects_ = false;

	bool isDefined(const CoffSymbol& symbol) const {
		return symbol.storageClass == 2 && (symbol.sectionNumber > 0 || symbol.sectionNumber == -1 || (symbol.sectionNumber == 0 && symbol.value != 0));
	}

	std::set<std::string> unresolvedNames() const {
		std::set<std::string> defined;
		std::set<std::string> unresolved;
		for (const auto& object : objects_) {
			for (const auto& symbol : object.symbols) {
				if (symbol.auxiliary || symbol.storageClass != 2 || symbol.name.empty()) {
					continue;
				}
				if (isDefined(symbol)) {
					defined.insert(symbol.name);
				} else if (symbol.sectionNumber == 0 && symbol.value == 0) {
					unresolved.insert(symbol.name);
				}
			}
		}
		for (const auto& name : defined) {
			unresolved.erase(name);
		}
		if (options_.entry) {
			if (!defined.contains(*options_.entry)) {
				unresolved.insert(*options_.entry);
			}
		} else if (!defined.contains("mainCRTStartup") && !defined.contains("main")) {
			unresolved.insert("mainCRTStartup");
		}
		return unresolved;
	}

	void validateUnresolvedSymbols() const {
		const auto unresolved = unresolvedNames();
		if (unresolved.empty()) {
			return;
		}
		std::ostringstream message;
		message << "unresolved external symbol" << (unresolved.size() == 1 ? " " : "s ");
		bool first = true;
		for (const auto& name : unresolved) {
			message << (first ? "'" : ", '") << name << "'";
			first = false;
		}
		if (hasImportObjects_) {
			message << "; this archive contains DLL import objects, which JWlink2 does not support yet";
		} else {
			message << "; supply an object or static library containing each definition";
		}
		fail(message.str());
	}

	void loadInputs() {
		for (const auto& path : options_.inputs) {
			const auto bytes = readFile(path);
			if (bytes.size() >= 8 && std::string_view(reinterpret_cast<const char*>(bytes.data()), 8) == "!<arch>\n") {
				auto archive = parseArchive(bytes, path.string());
				hasImportObjects_ = hasImportObjects_ || std::any_of(archive.begin(), archive.end(), [](const ArchiveMember& member) {
					return member.importObject;
				});
				archives_.push_back(std::move(archive));
			} else {
				objects_.push_back(parseObject(bytes, path.string()));
			}
		}
		}

		void resolveLibraries() {
			for (;;) {
				auto unresolved = unresolvedNames();
			if (unresolved.empty()) {
				return;
			}
			bool added = false;
			for (std::size_t archiveIndex = 0; archiveIndex < archives_.size(); ++archiveIndex) {
				auto& archive = archives_[archiveIndex];
				for (auto& member : archive) {
					if (member.selected || !member.object) {
						continue;
					}
					const bool needed = std::any_of(member.object->symbols.begin(), member.object->symbols.end(), [&](const CoffSymbol& symbol) {
						return isDefined(symbol) && unresolved.contains(symbol.name);
					});
					if (needed) {
						for (const auto& symbol : member.object->symbols) {
							if (isDefined(symbol)) {
								unresolved.erase(symbol.name);
							}
						}
						member.selected = true;
						objects_.push_back(std::move(*member.object));
						member.object.reset();
						added = true;
					}
				}
			}
			if (!added) {
				return;
			}
		}
	}

	std::size_t getOutputSection(const InputSection& input) {
		const auto subsection = input.name.find('$');
		const auto outputName = input.name.substr(0, subsection);
		for (std::size_t i = 0; i < outputSections_.size(); ++i) {
			if (outputSections_[i].name == outputName) {
				outputSections_[i].characteristics |= input.characteristics;
				outputSections_[i].alignment = std::max(outputSections_[i].alignment, static_cast<std::size_t>(input.alignment));
				return i;
			}
		}
		OutputSection section;
		section.name = outputName;
		section.characteristics = input.characteristics;
		section.alignment = input.alignment;
		outputSections_.push_back(std::move(section));
		return outputSections_.size() - 1;
	}

	void buildSections() {
		sectionMaps_.resize(objects_.size());
		for (std::size_t objectIndex = 0; objectIndex < objects_.size(); ++objectIndex) {
			const auto& object = objects_[objectIndex];
			auto& maps = sectionMaps_[objectIndex];
			maps.reserve(object.sections.size());
			for (const auto& input : object.sections) {
				const auto outputIndex = getOutputSection(input);
				auto& output = outputSections_[outputIndex];
				const auto offset = alignUp(output.virtualSize, input.alignment);
				if (input.data.size() > std::numeric_limits<std::size_t>::max() - offset || input.virtualSize > std::numeric_limits<std::size_t>::max() - offset) {
					fail(object.name + ": section size overflow");
				}
				if (!input.data.empty()) {
					if (output.data.size() < offset + input.data.size()) {
						output.data.resize(offset + input.data.size(), 0);
					}
					std::copy(input.data.begin(), input.data.end(), output.data.begin() + offset);
				}
				output.virtualSize = std::max(offset + input.virtualSize, offset + input.data.size());
				maps.push_back({outputIndex, offset});
			}
		}
	}

	void resolveGlobals() {
		for (std::size_t objectIndex = 0; objectIndex < objects_.size(); ++objectIndex) {
			const auto& object = objects_[objectIndex];
			for (std::size_t symbolIndex = 0; symbolIndex < object.symbols.size(); ++symbolIndex) {
				const auto& symbol = object.symbols[symbolIndex];
				if (symbol.auxiliary || symbol.storageClass != 2 || symbol.name.empty()) {
					continue;
				}
				if (symbol.sectionNumber > 0) {
					if (static_cast<std::size_t>(symbol.sectionNumber) > object.sections.size()) {
						fail(object.name + ": symbol refers to an invalid section");
					}
					GlobalSymbol definition{objectIndex, symbolIndex};
					const auto [it, inserted] = globals_.emplace(symbol.name, definition);
					if (!inserted) {
						if (!it->second.common) {
							fail("duplicate definition of symbol '" + symbol.name + "'");
						}
						it->second = definition;
					}
				} else if (symbol.sectionNumber == -1) {
					GlobalSymbol definition{objectIndex, symbolIndex};
					const auto [it, inserted] = globals_.emplace(symbol.name, definition);
					if (!inserted) {
						if (!it->second.common) {
							fail("duplicate definition of symbol '" + symbol.name + "'");
						}
						it->second = definition;
					}
				} else if (symbol.sectionNumber == 0 && symbol.value != 0) {
					const auto existing = globals_.find(symbol.name);
					if (existing != globals_.end()) {
						if (existing->second.common && symbol.value > existing->second.commonSize) {
							auto& output = outputSections_[existing->second.outputIndex];
							if (symbol.value > std::numeric_limits<std::size_t>::max() - existing->second.outputOffset) {
								fail(object.name + ": common symbol size overflow");
							}
							output.virtualSize = std::max(output.virtualSize, existing->second.outputOffset + symbol.value);
							existing->second.commonSize = symbol.value;
						}
						continue;
					}
					InputSection commonSection;
					commonSection.name = ".bss";
					commonSection.characteristics = SectionCntUninitializedData | SectionMemRead | SectionMemWrite;
					commonSection.alignment = 8;
					const auto outputIndex = getOutputSection(commonSection);
					auto& output = outputSections_[outputIndex];
					const auto offset = alignUp(output.virtualSize, 8);
					if (symbol.value > std::numeric_limits<std::size_t>::max() - offset) {
						fail(object.name + ": common symbol size overflow");
					}
					output.virtualSize = offset + symbol.value;
					globals_.emplace(symbol.name, GlobalSymbol{objectIndex, symbolIndex, true, symbol.value, outputIndex, offset});
				}
			}
		}
	}

	std::uint64_t symbolAddress(std::size_t objectIndex, std::size_t symbolIndex) const {
		const auto& object = objects_.at(objectIndex);
		const auto& symbol = object.symbols.at(symbolIndex);
		if (symbol.sectionNumber == -1) {
			return symbol.value;
		}
		if (symbol.sectionNumber > 0) {
			const auto& mapping = sectionMaps_.at(objectIndex).at(static_cast<std::size_t>(symbol.sectionNumber - 1));
			return ImageBase + outputSections_.at(mapping.outputIndex).rva + mapping.offset + symbol.value;
		}
		const auto found = globals_.find(symbol.name);
		if (found == globals_.end()) {
			fail("unresolved external symbol '" + symbol.name + "'");
		}
		const auto& definition = found->second;
		if (definition.common) {
			return ImageBase + outputSections_.at(definition.outputIndex).rva + definition.outputOffset;
		}
		const auto& definingObject = objects_.at(definition.objectIndex);
		const auto& definingSymbol = definingObject.symbols.at(definition.symbolIndex);
		if (definingSymbol.sectionNumber == -1) {
			return definingSymbol.value;
		}
		const auto& mapping = sectionMaps_.at(definition.objectIndex).at(static_cast<std::size_t>(definingSymbol.sectionNumber - 1));
		return ImageBase + outputSections_.at(mapping.outputIndex).rva + mapping.offset + definingSymbol.value;
	}

	std::uint32_t entryRva() const {
		std::string entry;
		if (options_.entry) {
			entry = *options_.entry;
		} else if (globals_.contains("mainCRTStartup")) {
			entry = "mainCRTStartup";
		} else if (globals_.contains("main")) {
			entry = "main";
		} else {
			fail("no entry point found; use --entry <symbol> (for example, --entry main)");
		}
		const auto found = globals_.find(entry);
		if (found == globals_.end()) {
			fail("entry point symbol '" + entry + "' was not found");
		}
		const auto& definition = found->second;
		if (definition.common) {
			fail("entry point '" + entry + "' cannot be a common symbol");
		}
		const auto& symbol = objects_.at(definition.objectIndex).symbols.at(definition.symbolIndex);
		if (symbol.sectionNumber <= 0) {
			fail("entry point '" + entry + "' is not defined in a section");
		}
		const auto& mapping = sectionMaps_.at(definition.objectIndex).at(static_cast<std::size_t>(symbol.sectionNumber - 1));
		const auto rva = static_cast<std::uint64_t>(outputSections_.at(mapping.outputIndex).rva) + mapping.offset + symbol.value;
		return toU32(static_cast<std::size_t>(rva), "entry point RVA");
	}

	void layoutImage() {
		if (outputSections_.empty()) {
			fail("input objects contain no sections");
		}
		if (outputSections_.size() > 96) {
			fail("PE image exceeds the Windows section-count limit");
		}
		const auto headersUnaligned = 0x80u + 4u + 20u + 240u + outputSections_.size() * 40u;
		const auto headersSize = alignUp(headersUnaligned, FileAlignment);
		std::size_t nextRva = SectionAlignment;
		std::size_t nextRaw = headersSize;
		for (auto& section : outputSections_) {
			nextRva = alignUp(nextRva, SectionAlignment);
			section.rva = toU32(nextRva, "section RVA");
			const auto virtualSize = std::max(section.virtualSize, section.data.size());
			if (virtualSize > std::numeric_limits<std::size_t>::max() - nextRva) {
				fail("PE image size overflow");
			}
			nextRva += alignUp(virtualSize, SectionAlignment);
			if (!section.data.empty()) {
				nextRaw = alignUp(nextRaw, FileAlignment);
				section.rawOffset = toU32(nextRaw, "section raw offset");
				section.rawSize = toU32(alignUp(section.data.size(), FileAlignment), "section raw size");
				nextRaw += section.rawSize;
			}
		}
		toU32(nextRva, "PE image size");
		toU32(nextRaw, "PE file size");
		(void)entryRva();
	}

	void applyRelocations() {
		for (std::size_t objectIndex = 0; objectIndex < objects_.size(); ++objectIndex) {
			const auto& object = objects_[objectIndex];
			for (std::size_t inputIndex = 0; inputIndex < object.sections.size(); ++inputIndex) {
				const auto& input = object.sections[inputIndex];
				const auto& mapping = sectionMaps_[objectIndex][inputIndex];
				auto& output = outputSections_[mapping.outputIndex];
				for (const auto& relocation : input.relocations) {
					if (relocation.type == 0) {
						continue;
					}
					if (relocation.offset >= input.data.size()) {
						fail(object.name + ": relocation offset is outside its section");
					}
					auto target = symbolAddress(objectIndex, relocation.symbolIndex);
					const auto placeRva = static_cast<std::uint64_t>(output.rva) + mapping.offset + relocation.offset;
					const auto outputOffset = mapping.offset + relocation.offset;
					if (relocation.type == 1) {
						if (input.data.size() - relocation.offset < 8) {
							fail(object.name + ": ADDR64 relocation is outside initialized section data");
						}
						const auto addend = static_cast<std::int64_t>(readLe<std::uint64_t>(output.data, outputOffset, object.name));
						const auto relocated = static_cast<std::uint64_t>(static_cast<std::int64_t>(target) + addend);
						writeLe(output.data, outputOffset, relocated);
					} else if (relocation.type == 2 || relocation.type == 3 || (relocation.type >= 4 && relocation.type <= 9)) {
						if (input.data.size() - relocation.offset < 4) {
							fail(object.name + ": 32-bit relocation is outside initialized section data");
						}
						const auto addend = static_cast<std::int32_t>(readLe<std::uint32_t>(output.data, outputOffset, object.name));
						std::int64_t relocated = 0;
						if (relocation.type == 2) {
							relocated = static_cast<std::int64_t>(target) + addend;
						} else if (relocation.type == 3) {
						relocated = static_cast<std::int64_t>(target) - static_cast<std::int64_t>(ImageBase) + addend;
						} else {
							const auto extra = static_cast<std::int64_t>(relocation.type - 4);
							relocated = static_cast<std::int64_t>(target) + addend - static_cast<std::int64_t>(ImageBase + placeRva + 4 + extra);
						}
						const bool pcRelative = relocation.type >= 4;
						const auto minimum = pcRelative ? static_cast<std::int64_t>(std::numeric_limits<std::int32_t>::min()) : 0;
						const auto maximum = pcRelative ? static_cast<std::int64_t>(std::numeric_limits<std::int32_t>::max()) : static_cast<std::int64_t>(std::numeric_limits<std::uint32_t>::max());
						if (relocated < minimum || relocated > maximum) {
							fail(object.name + ": relocation result does not fit its 32-bit relocation type");
						}
						writeLe(output.data, outputOffset, static_cast<std::uint32_t>(relocated));
					} else {
						std::ostringstream message;
						message << object.name << ": unsupported AMD64 relocation type 0x" << std::hex << relocation.type;
						fail(message.str());
					}
				}
			}
		}
	}

	void writeImage() {
		const auto headersSize = alignUp(0x80u + 4u + 20u + 240u + outputSections_.size() * 40u, FileAlignment);
		std::size_t fileSize = headersSize;
		std::size_t imageSize = SectionAlignment;
		std::uint32_t codeSize = 0;
		std::uint32_t initializedSize = 0;
		std::uint32_t uninitializedSize = 0;
		std::uint32_t baseOfCode = 0;
		for (const auto& section : outputSections_) {
			imageSize = std::max(imageSize, static_cast<std::size_t>(section.rva) + alignUp(std::max(section.virtualSize, section.data.size()), SectionAlignment));
			if (section.rawSize != 0) {
				fileSize = std::max(fileSize, static_cast<std::size_t>(section.rawOffset) + section.rawSize);
			}
			if ((section.characteristics & SectionCntCode) != 0) {
				codeSize += section.rawSize;
				if (baseOfCode == 0) {
					baseOfCode = section.rva;
				}
			} else if ((section.characteristics & SectionCntUninitializedData) != 0) {
				uninitializedSize += toU32(section.virtualSize, "uninitialized section size");
			} else {
				initializedSize += section.rawSize;
			}
		}
		Bytes image(fileSize, 0);
		image[0] = 'M';
		image[1] = 'Z';
		constexpr std::string_view dosMessage = "This program cannot be run in DOS mode.\r\n$";
		std::copy(dosMessage.begin(), dosMessage.end(), image.begin() + 0x40);
		writeLe(image, 0x3c, std::uint32_t{0x80});
		image[0x80] = 'P';
		image[0x81] = 'E';
		const std::size_t coff = 0x84;
		writeLe(image, coff, MachineAmd64);
		writeLe(image, coff + 2, static_cast<std::uint16_t>(outputSections_.size()));
		writeLe(image, coff + 16, std::uint16_t{240});
		writeLe(image, coff + 18, std::uint16_t{0x0022});
		const std::size_t optional = coff + 20;
		writeLe(image, optional, std::uint16_t{0x020b});
		writeLe(image, optional + 4, codeSize);
		writeLe(image, optional + 8, initializedSize);
		writeLe(image, optional + 12, uninitializedSize);
		writeLe(image, optional + 16, entryRva());
		writeLe(image, optional + 20, baseOfCode);
		writeLe(image, optional + 24, ImageBase);
		writeLe(image, optional + 32, SectionAlignment);
		writeLe(image, optional + 36, FileAlignment);
		writeLe(image, optional + 40, std::uint16_t{6});
		writeLe(image, optional + 48, std::uint16_t{6});
		writeLe(image, optional + 56, toU32(imageSize, "PE image size"));
		writeLe(image, optional + 60, toU32(headersSize, "PE headers size"));
		writeLe(image, optional + 68, options_.subsystem);
		writeLe(image, optional + 70, std::uint16_t{0x0100});
		writeLe(image, optional + 72, std::uint64_t{0x100000});
		writeLe(image, optional + 80, std::uint64_t{0x1000});
		writeLe(image, optional + 88, std::uint64_t{0x100000});
		writeLe(image, optional + 96, std::uint64_t{0x1000});
		writeLe(image, optional + 108, std::uint32_t{16});

		const auto sectionHeaders = optional + 240;
		for (std::size_t i = 0; i < outputSections_.size(); ++i) {
			const auto& section = outputSections_[i];
			const auto header = sectionHeaders + i * 40;
			const auto nameLength = std::min<std::size_t>(section.name.size(), 8);
			std::copy_n(section.name.begin(), nameLength, image.begin() + header);
			writeLe(image, header + 8, toU32(std::max(section.virtualSize, section.data.size()), "section virtual size"));
			writeLe(image, header + 12, section.rva);
			writeLe(image, header + 16, section.rawSize);
			writeLe(image, header + 20, section.rawOffset);
			writeLe(image, header + 36, section.characteristics);
			if (section.rawSize != 0) {
				std::copy(section.data.begin(), section.data.end(), image.begin() + section.rawOffset);
			}
		}

		std::ofstream output(options_.output, std::ios::binary | std::ios::trunc);
		if (!output) {
			fail("cannot create '" + options_.output.string() + "'");
		}
		output.write(reinterpret_cast<const char*>(image.data()), static_cast<std::streamsize>(image.size()));
		if (!output) {
			fail("failed writing '" + options_.output.string() + "'");
		}
		std::cout << "JWlink2: wrote " << options_.output.string() << " (" << image.size() << " bytes)\n";
	}
};

void printUsage() {
	std::cout << "JWlink2 - AMD64 COFF to Windows PE32+ linker\n"
				 "Usage: JWlink2 [options] input.obj [input.lib ...]\n"
				 "  -o <file>             Output executable (default: a.exe)\n"
				 "  --entry <symbol>      Entry point symbol (default: mainCRTStartup, then main)\n"
				 "  --subsystem <name>    console (default) or windows\n"
				 "  -h, --help            Show this help\n";
}

LinkOptions parseArguments(int argc, char** argv) {
	LinkOptions options;
	for (int i = 1; i < argc; ++i) {
		const std::string argument = argv[i];
		if (argument == "-h" || argument == "--help") {
			printUsage();
			std::exit(0);
		} else if (argument == "-o") {
			if (++i == argc) {
				fail("-o requires an output path");
			}
			options.output = argv[i];
		} else if (argument == "--entry") {
			if (++i == argc) {
				fail("--entry requires a symbol name");
			}
			options.entry = argv[i];
		} else if (argument == "--subsystem") {
			if (++i == argc) {
				fail("--subsystem requires console or windows");
			}
			const std::string subsystem = argv[i];
			if (subsystem == "console") {
				options.subsystem = 3;
			} else if (subsystem == "windows") {
				options.subsystem = 2;
			} else {
				fail("unsupported subsystem '" + subsystem + "' (choose console or windows)");
			}
		} else if (!argument.empty() && argument[0] == '-') {
			fail("unknown option '" + argument + "'");
		} else {
			options.inputs.emplace_back(argument);
		}
	}
	if (options.inputs.empty()) {
		fail("no input object files or libraries were supplied; use --help for usage");
	}
	return options;
}
} // namespace

int main(int argc, char** argv) {
	try {
		Linker(parseArguments(argc, argv)).run();
		return 0;
	} catch (const std::exception& error) {
		std::cerr << "JWlink2: error: " << error.what() << '\n';
		return 1;
	}
}
