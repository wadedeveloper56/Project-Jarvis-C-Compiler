struct ImportedSymbol {
	std::string publicName;
	std::string dllName;
	std::string importName;
	std::uint16_t ordinalOrHint = 0;
	std::uint8_t type = 0;
	std::uint8_t nameType = 0;
	bool byOrdinal = false;
};

ImportedSymbol parseImportObject(const Bytes& bytes, const std::string& path) {
	requireRange(bytes, 0, 20, path + " import object");
	if (readLe<std::uint16_t>(bytes, 0, path) != 0 || readLe<std::uint16_t>(bytes, 2, path) != 0xffff) {
		fail(path + ": malformed COFF import object signature");
	}
	const auto machine = readLe<std::uint16_t>(bytes, 6, path);
	if (machine != MachineAmd64) {
		fail(path + ": import library member is not AMD64");
	}
	const auto dataSize = readLe<std::uint32_t>(bytes, 12, path);
	const auto hint = readLe<std::uint16_t>(bytes, 16, path);
	const auto typeInfo = readLe<std::uint16_t>(bytes, 18, path);
	if ((typeInfo & 3) > 2 || ((typeInfo >> 2) & 7) > 4) {
		fail(path + ": unsupported COFF import-object type or name encoding");
	}
	requireRange(bytes, 20, dataSize, path + " import-object strings");
	auto readString = [&](std::size_t& offset) {
		if (offset >= 20 + dataSize) {
			fail(path + ": truncated COFF import-object strings");
		}
		const auto begin = offset;
		while (offset < 20 + dataSize && bytes[offset] != 0) {
			++offset;
		}
		if (offset == 20 + dataSize) {
			fail(path + ": unterminated COFF import-object string");
		}
		std::string value(reinterpret_cast<const char*>(bytes.data() + begin), offset - begin);
		++offset;
		return value;
	};
	std::size_t cursor = 20;
	ImportedSymbol result;
	result.publicName = readString(cursor);
	result.dllName = readString(cursor);
	result.ordinalOrHint = hint;
	result.type = static_cast<std::uint8_t>(typeInfo & 3);
	result.nameType = static_cast<std::uint8_t>((typeInfo >> 2) & 7);
	result.byOrdinal = result.nameType == 0;
	if (result.publicName.empty() || result.dllName.empty()) {
		fail(path + ": import object has an empty symbol or DLL name");
	}
	if (result.byOrdinal) {
		result.importName = result.publicName;
	} else if (result.nameType == 1) {
		result.importName = result.publicName;
	} else if (result.nameType == 2 || result.nameType == 3) {
		result.importName = result.publicName;
		if (!result.importName.empty() && (result.importName.front() == '?' || result.importName.front() == '@' || result.importName.front() == '_')) {
			result.importName.erase(result.importName.begin());
		}
		if (result.nameType == 3) {
			const auto decoration = result.importName.rfind('@');
			if (decoration != std::string::npos) {
				result.importName.erase(decoration);
			}
		}
	} else {
		result.importName = readString(cursor);
	}
	if (result.importName.empty() && !result.byOrdinal) {
		fail(path + ": import object resolves to an empty import name");
	}
	return result;
}

std::uint32_t coffNameOffset(const Bytes& bytes, std::size_t offset) {
	if (bytes[offset] == '/' && bytes[offset + 1] != 0) {
		std::string text = fixedString(bytes, offset + 1, 7);
		std::uint32_t result = 0;
		const auto parsed = std::from_chars(text.data(), text.data() + text.size(), result);
		if (parsed.ec != std::errc{} || parsed.ptr == text.data()) {
			fail("invalid long COFF section name");
		}
		return result;
	}
	return 0;
}

ObjectFile parseObject(const Bytes& bytes, std::string name) {
	requireRange(bytes, 0, 20, name);
	const auto machine = readLe<std::uint16_t>(bytes, 0, name);
	if (machine != MachineAmd64) {
		std::ostringstream message;
		message << name << ": expected AMD64 COFF object (machine 0x8664), got 0x" << std::hex << machine;
		fail(message.str());
	}
	const auto sectionCount = readLe<std::uint16_t>(bytes, 2, name);
	const auto symbolOffset = readLe<std::uint32_t>(bytes, 8, name);
	const auto symbolCount = readLe<std::uint32_t>(bytes, 12, name);
	const auto optionalSize = readLe<std::uint16_t>(bytes, 16, name);
	const std::size_t sectionTable = 20u + optionalSize;
	requireRange(bytes, sectionTable, static_cast<std::size_t>(sectionCount) * 40, name + " section table");

	std::size_t stringTableOffset = 0;
	std::uint32_t stringTableSize = 0;
	if (symbolCount != 0) {
		if (symbolOffset == 0) {
			fail(name + ": missing COFF symbol table");
		}
		const auto symbolsBytes = static_cast<std::size_t>(symbolCount) * 18;
		requireRange(bytes, symbolOffset, symbolsBytes, name + " symbol table");
		stringTableOffset = static_cast<std::size_t>(symbolOffset) + symbolsBytes;
		requireRange(bytes, stringTableOffset, 4, name + " string table");
		stringTableSize = readLe<std::uint32_t>(bytes, stringTableOffset, name + " string table");
		if (stringTableSize < 4) {
			fail(name + ": invalid COFF string table size");
		}
		requireRange(bytes, stringTableOffset, stringTableSize, name + " string table");
	}

	ObjectFile object;
	object.name = std::move(name);
	object.sections.reserve(sectionCount);
	for (std::uint16_t i = 0; i < sectionCount; ++i) {
		const auto header = sectionTable + static_cast<std::size_t>(i) * 40;
		const auto nameOffset = coffNameOffset(bytes, header);
		std::string sectionName = fixedString(bytes, header, 8);
		if (nameOffset != 0) {
			if (stringTableSize == 0) {
				fail(object.name + ": long section name without a COFF string table");
			}
			sectionName = stringAt(bytes, stringTableOffset, stringTableSize, nameOffset, "section");
		}
		if (sectionName.empty()) {
			fail(object.name + ": section with an empty name");
		}
		InputSection section;
		section.name = std::move(sectionName);
		section.virtualSize = readLe<std::uint32_t>(bytes, header + 8, object.name);
		const auto rawSize = readLe<std::uint32_t>(bytes, header + 16, object.name);
		const auto rawOffset = readLe<std::uint32_t>(bytes, header + 20, object.name);
		const auto relocationOffset = readLe<std::uint32_t>(bytes, header + 24, object.name);
		const auto relocationCount = readLe<std::uint16_t>(bytes, header + 32, object.name);
		section.characteristics = readLe<std::uint32_t>(bytes, header + 36, object.name);
		const auto alignmentCode = (section.characteristics >> 20) & 0x0f;
		if (alignmentCode > 14) {
			fail(object.name + ": unsupported section alignment");
		}
		section.alignment = alignmentCode == 0 ? 1u : (1u << (alignmentCode - 1));
		if (rawSize != 0) {
			requireRange(bytes, rawOffset, rawSize, object.name + " section data");
			section.data.assign(bytes.begin() + rawOffset, bytes.begin() + rawOffset + rawSize);
		}
		if (relocationCount == 0xffff) {
			fail(object.name + ": extended COFF relocation tables are not supported");
		}
		if (relocationCount != 0) {
			requireRange(bytes, relocationOffset, static_cast<std::size_t>(relocationCount) * 10, object.name + " relocation table");
			section.relocations.reserve(relocationCount);
			for (std::uint16_t r = 0; r < relocationCount; ++r) {
				const auto entry = static_cast<std::size_t>(relocationOffset) + static_cast<std::size_t>(r) * 10;
				section.relocations.push_back({
					readLe<std::uint32_t>(bytes, entry, object.name),
					readLe<std::uint32_t>(bytes, entry + 4, object.name),
					readLe<std::uint16_t>(bytes, entry + 8, object.name)
				});
			}
		}
		if (section.virtualSize < rawSize) {
			section.virtualSize = rawSize;
		}
		object.sections.push_back(std::move(section));
	}

	object.symbols.resize(symbolCount);
	for (std::uint32_t i = 0; i < symbolCount;) {
		const auto entry = static_cast<std::size_t>(symbolOffset) + static_cast<std::size_t>(i) * 18;
		const auto nameZeroes = readLe<std::uint32_t>(bytes, entry, object.name);
		const auto nameOffset = readLe<std::uint32_t>(bytes, entry + 4, object.name);
		auto& symbol = object.symbols[i];
		if (nameZeroes == 0) {
			if (stringTableSize == 0) {
				fail(object.name + ": symbol uses a missing COFF string table");
			}
			symbol.name = stringAt(bytes, stringTableOffset, stringTableSize, nameOffset, "symbol");
		} else {
			symbol.name = fixedString(bytes, entry, 8);
		}
		symbol.value = readLe<std::uint32_t>(bytes, entry + 8, object.name);
		symbol.sectionNumber = static_cast<std::int16_t>(readLe<std::uint16_t>(bytes, entry + 12, object.name));
		symbol.storageClass = bytes[entry + 16];
		const auto auxiliaryCount = bytes[entry + 17];
		if (auxiliaryCount > symbolCount - i - 1) {
			fail(object.name + ": invalid COFF auxiliary symbol count");
		}
		if (auxiliaryCount != 0) {
			const auto auxiliary = entry + 18;
			if (symbol.storageClass == 105 && symbol.sectionNumber == 0) {
				symbol.weakTagIndex = readLe<std::uint32_t>(bytes, auxiliary, object.name);
				symbol.weakCharacteristics = readLe<std::uint32_t>(bytes, auxiliary + 4, object.name);
			} else if (symbol.storageClass == 3 && symbol.sectionNumber > 0) {
				auto& section = object.sections.at(static_cast<std::size_t>(symbol.sectionNumber - 1));
				if ((section.characteristics & 0x00001000) != 0) {
					section.comdatSelection = bytes[auxiliary + 14];
					section.associatedSection = readLe<std::uint16_t>(bytes, auxiliary + 12, object.name);
				}
			}
		}
		for (std::uint32_t aux = 1; aux <= auxiliaryCount; ++aux) {
			object.symbols[i + aux].auxiliary = true;
		}
		i += static_cast<std::uint32_t>(auxiliaryCount) + 1;
	}
	for (const auto& symbol : object.symbols) {
		if (!symbol.auxiliary && symbol.storageClass == 2 && symbol.sectionNumber > 0 && static_cast<std::size_t>(symbol.sectionNumber) <= object.sections.size()) {
			auto& section = object.sections[static_cast<std::size_t>(symbol.sectionNumber - 1)];
			if (section.comdatSelection != 0 && section.comdatKey.empty()) {
				section.comdatKey = symbol.name;
			}
		}
	}
	for (const auto& section : object.sections) {
		if (section.comdatSelection > 7) {
			fail(object.name + ": unsupported COMDAT selection type");
		}
		if (section.comdatSelection != 0 && section.comdatKey.empty()) {
			fail(object.name + ": COMDAT section has no external selection key");
		}
	}
	for (const auto& section : object.sections) {
		for (const auto& relocation : section.relocations) {
			if (relocation.symbolIndex >= object.symbols.size() || object.symbols[relocation.symbolIndex].auxiliary) {
				fail(object.name + ": relocation refers to an invalid COFF symbol");
			}
		}
	}
	return object;
}

struct ArchiveMember {
	std::string name;
	std::optional<ObjectFile> object;
	std::optional<ImportedSymbol> imported;
	bool selected = false;
};

std::size_t parseDecimal(const Bytes& bytes, std::size_t offset, std::size_t length, std::string_view what) {
	const auto text = fixedString(bytes, offset, length);
	const auto first = text.find_first_not_of(' ');
	if (first == std::string::npos) {
		return 0;
	}
	auto last = text.find_last_not_of(' ');
	std::size_t value = 0;
	const auto parsed = std::from_chars(text.data() + first, text.data() + last + 1, value);
	if (parsed.ec != std::errc{} || parsed.ptr != text.data() + last + 1) {
		fail("invalid archive " + std::string(what));
	}
	return value;
}

std::vector<ArchiveMember> parseArchive(const Bytes& bytes, const std::string& path) {
	constexpr std::string_view magic = "!<arch>\n";
	if (bytes.size() < magic.size() || !std::equal(magic.begin(), magic.end(), bytes.begin())) {
		fail(path + ": not a Microsoft COFF library archive");
	}
	std::vector<ArchiveMember> members;
	std::string longNames;
	std::size_t position = magic.size();
	while (position < bytes.size()) {
		requireRange(bytes, position, 60, path + " archive member header");
		if (bytes[position + 58] != '`' || bytes[position + 59] != '\n') {
			fail(path + ": malformed archive member header");
		}
		const auto memberSize = parseDecimal(bytes, position + 48, 10, "member size");
		const auto dataOffset = position + 60;
		requireRange(bytes, dataOffset, memberSize, path + " archive member");
		auto rawName = fixedString(bytes, position, 16);
		while (!rawName.empty() && rawName.back() == ' ') {
			rawName.pop_back();
		}
		std::string memberName = rawName;
		if (memberName == "//") {
			longNames.assign(reinterpret_cast<const char*>(bytes.data() + dataOffset), memberSize);
		} else if (memberName != "/" && memberName != "/SYM64/") {
			if (memberName.size() > 1 && memberName[0] == '/' && std::isdigit(static_cast<unsigned char>(memberName[1]))) {
				std::size_t nameOffset = 0;
				const auto parsed = std::from_chars(memberName.data() + 1, memberName.data() + memberName.size(), nameOffset);
				if (parsed.ec != std::errc{} || nameOffset >= longNames.size()) {
					fail(path + ": invalid archive long-name offset");
				}
				const auto end = longNames.find("/\n", nameOffset);
				memberName = longNames.substr(nameOffset, end == std::string::npos ? std::string::npos : end - nameOffset);
			} else if (memberName.size() > 1 && memberName.back() == '/') {
				memberName.pop_back();
			}
			ArchiveMember member;
			member.name = memberName;
			if (memberSize >= 20) {
				const auto machine = readLe<std::uint16_t>(bytes, dataOffset, path);
				const auto signature = readLe<std::uint16_t>(bytes, dataOffset + 2, path);
				if (machine == 0 && signature == 0xffff) {
					member.imported = parseImportObject(bytes, path + "(" + memberName + ")");
				} else if (machine == MachineAmd64 || machine == 0x014c) {
					Bytes objectBytes(bytes.begin() + dataOffset, bytes.begin() + dataOffset + memberSize);
					member.object = parseObject(objectBytes, path + "(" + memberName + ")");
				}
			}
			members.push_back(std::move(member));
		}
		position = dataOffset + memberSize;
		if ((position & 1) != 0) {
			++position;
		}
	}
	if (position != bytes.size()) {
		fail(path + ": archive ends with an incomplete member");
	}
	return members;
}

Bytes readFile(const fs::path& path) {
	std::ifstream input(path, std::ios::binary);
	if (!input) {
		fail("cannot open '" + path.string() + "'");
	}
	input.seekg(0, std::ios::end);
	const auto length = input.tellg();
	if (length < 0 || static_cast<std::uint64_t>(length) > std::numeric_limits<std::size_t>::max()) {
		fail("cannot determine file size for '" + path.string() + "'");
	}
	Bytes bytes(static_cast<std::size_t>(length));
	input.seekg(0, std::ios::beg);
	if (!bytes.empty() && !input.read(reinterpret_cast<char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()))) {
		fail("failed reading '" + path.string() + "'");
	}
	return bytes;
}

