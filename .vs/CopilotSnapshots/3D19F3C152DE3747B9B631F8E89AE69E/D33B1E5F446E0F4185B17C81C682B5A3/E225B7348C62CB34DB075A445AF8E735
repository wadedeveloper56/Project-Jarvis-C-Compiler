MasmCodeGenerator::MasmCodeGenerator(shared_ptr<vector<shared_ptr<VariableData>>> variableTable, shared_ptr<vector<shared_ptr<FunctionData>>> functionTable): BaseCodeGenerator(variableTable, functionTable)
{}

static thread_local shared_ptr<vector<shared_ptr<VariableData>>> masm_current_locals;
static thread_local shared_ptr<vector<shared_ptr<VariableData>>> masm_current_params;
static thread_local shared_ptr<vector<shared_ptr<VariableData>>> masm_current_globals;

static string asmAccumulatorRegister()
{
	if (bit16) return "ax";
	if (bit32) return "eax";
	return "rax";
}

static string asmSecondaryRegister()
{
	if (bit16) return "bx";
	if (bit32) return "ebx";
	return "rbx";
}

static string asmHighRegister()
{
	if (bit16) return "dx";
	if (bit32) return "edx";
	return "rdx";
}

static size_t asmArchitectureBytes()
{
	if (bit16) return 2;
	if (bit32) return 4;
	return 8;
}

static size_t asmVariableBytes(const VariableData& variable)
{
	if (variable.pointer) return asmArchitectureBytes();
	if (!variable.type) return asmArchitectureBytes();
	switch (variable.type.value())
	{
	case CHAR:
	case BOOLT:
		return 1;
	case SHORTT:
		return 2;
	case INT:
		return bit16 ? 2 : 4;
	case LONG:
		return 4;
	case LONG_LONG:
	case DOUBLE:
		return 8;
	case FLOAT:
		return 4;
	case LONG_DOUBLE:
		return 10;
	default:
		return asmArchitectureBytes();
	}
}

static string asmMemorySize(size_t bytes)
{
	if (bytes <= 1) return "BYTE";
	if (bytes <= 2) return "WORD";
	if (bytes <= 4) return "DWORD";
	return "QWORD";
}

static string asmRegisterForBytes(size_t bytes)
{
	if (bytes <= 1) return "al";
	if (bytes <= 2) return "ax";
	if (bytes <= 4) return "eax";
	return "rax";
}

static shared_ptr<VariableData> asmFindVariable(const string& name)
{
	const shared_ptr<vector<shared_ptr<VariableData>>> tables[] =
	{
		masm_current_locals, masm_current_params, masm_current_globals
	};
	for (const auto& table : tables)
	{
		if (!table) continue;
		for (const auto& variable : *table)
		{
			if (variable && variable->name == name) return variable;
		}
	}
	return nullptr;
}

static string asmExpressionVariable(const string& name)
{
	return "_" + name;
}

static bool asmLoadVariable(ostream& out, const string& name)
{
	const string operand = asmExpressionVariable(name);
	auto variable = asmFindVariable(name);
	if (!variable)
	{
		out << "\tmov " << asmAccumulatorRegister() << ", " << operand << endl;
		return true;
	}

	const size_t sourceBytes = asmVariableBytes(*variable);
	const size_t registerBytes = asmArchitectureBytes();
	const string accumulator = asmAccumulatorRegister();
	if (sourceBytes < registerBytes)
	{
		const string size = asmMemorySize(sourceBytes);
		if (sourceBytes == 4 && registerBytes == 8)
		{
			if (variable->unsign) out << "\tmov eax, DWORD PTR " << operand << endl;
			else out << "\tmovsxd rax, DWORD PTR " << operand << endl;
		}
		else
		{
			out << "\tmov" << (variable->unsign ? "zx " : "sx ") << accumulator << ", " << size << " PTR " << operand << endl;
		}
	}
	else if (sourceBytes > registerBytes)
	{
		out << "\tmov " << accumulator << ", " << asmMemorySize(registerBytes) << " PTR " << operand << endl;
	}
	else
	{
		out << "\tmov " << accumulator << ", " << operand << endl;
	}
	return true;
}

static void asmStoreVariable(ostream& out, const string& name)
{
	const string operand = asmExpressionVariable(name);
	auto variable = asmFindVariable(name);
	if (!variable)
	{
		out << "\tmov " << asmMemorySize(asmArchitectureBytes()) << " PTR " << operand << ", " << asmAccumulatorRegister() << endl;
		return;
	}

	const size_t destinationBytes = asmVariableBytes(*variable);
	const size_t registerBytes = asmArchitectureBytes();
	if (destinationBytes <= registerBytes)
	{
		out << "\tmov " << asmMemorySize(destinationBytes) << " PTR " << operand << ", "
			<< asmRegisterForBytes(destinationBytes) << endl;
		return;
	}

	out << "\tmov " << asmMemorySize(registerBytes) << " PTR " << operand << ", " << asmAccumulatorRegister() << endl;
	if (variable->unsign)
	{
		out << "\txor " << asmHighRegister() << ", " << asmHighRegister() << endl;
	}
	else if (bit16)
	{
		out << "\tcwd" << endl;
	}
	else if (bit32)
	{
		out << "\tcdq" << endl;
	}
	else
	{
		out << "\tcqo" << endl;
	}
	for (size_t offset = registerBytes; offset < destinationBytes; offset += registerBytes)
	{
		out << "\tmov " << asmMemorySize(registerBytes) << " PTR " << operand << "+" << offset << ", " << asmHighRegister() << endl;
	}
}

static shared_ptr<CToken> asmExpressionIdentifier(shared_ptr<TreeNodeData> data)
{
	if (!data) return nullptr;
	if (data->hasIdentifier()) return data->getIdentifier();
	return data->hasToken3() ? data->getToken3() : nullptr;
}

static string asmOperatorText(shared_ptr<CToken> op)
{
	if (!op) return "";
	string text = op->getKeywordName();
	return text.empty() ? op->getSymbolName() : text;
}

static bool emitMasmExpression(ostream& out, shared_ptr<TreeNode> node)
{
	if (!node || !node->hasData()) return false;

	auto data = node->getData();
	const string accumulator = asmAccumulatorRegister();
	const string secondary = asmSecondaryRegister();

	if (data->hasConstant())
	{
		auto integer = data->getIConst();
		if (!integer) return false;
		out << "\tmov " << accumulator << ", " << integer->getIntegerConst() << endl;
		return true;
	}

	auto identifier = asmExpressionIdentifier(data);
	if (identifier)
	{
		return asmLoadVariable(out, identifier->getSymbolName());
	}

	if (data->getType() == NT_OP && data->hasOp() && data->getOp())
	{
		const string op = asmOperatorText(data->getOp());
		auto left = node->getLeft();
		auto right = node->getRight();
		if (op == "=" || op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" ||
			op == "&=" || op == "|=" || op == "^=" || op == "<<=" || op == ">>=")
		{
			if (!left || !left->hasData() || !right) return false;
			auto targetIdentifier = asmExpressionIdentifier(left->getData());
			if (!targetIdentifier) return false;
			const string destination = targetIdentifier->getSymbolName();
			if (op == "=")
			{
				if (!emitMasmExpression(out, right)) return false;
			}
			else
			{
				if (!asmLoadVariable(out, destination)) return false;
				out << "\tpush " << accumulator << endl;
				if (!emitMasmExpression(out, right)) return false;
				if (op == "<<=" || op == ">>=")
				{
					out << "\tmov cl, al" << endl;
					out << "\tpop " << accumulator << endl;
					out << "\t" << (op == "<<=" ? "shl " : "sar ") << accumulator << ", cl" << endl;
				}
				else
				{
					out << "\tmov " << secondary << ", " << accumulator << endl;
					out << "\tpop " << accumulator << endl;
					if (op == "+=") out << "\tadd " << accumulator << ", " << secondary << endl;
					else if (op == "-=") out << "\tsub " << accumulator << ", " << secondary << endl;
					else if (op == "*=") out << "\timul " << accumulator << ", " << secondary << endl;
					else if (op == "&=") out << "\tand " << accumulator << ", " << secondary << endl;
					else if (op == "|=") out << "\tor " << accumulator << ", " << secondary << endl;
					else if (op == "^=") out << "\txor " << accumulator << ", " << secondary << endl;
					else
					{
						if (bit16) out << "\tcwd" << endl;
						else if (bit32) out << "\tcdq" << endl;
						else out << "\tcqo" << endl;
						out << "\tidiv " << secondary << endl;
						if (op == "%=") out << "\tmov " << accumulator << ", " << asmHighRegister() << endl;
					}
				}
			}
			asmStoreVariable(out, destination);
			return true;
		}

		if (op == ",")
		{
			return emitMasmExpression(out, left) && emitMasmExpression(out, right);
		}

		if (op == "+" || op == "-" || op == "*" || op == "/" || op == "%" ||
			op == "&" || op == "|" || op == "^")
		{
			if (!emitMasmExpression(out, left)) return false;
			out << "\tpush " << accumulator << endl;
			if (!emitMasmExpression(out, right)) return false;
			out << "\tmov " << secondary << ", " << accumulator << endl;
			out << "\tpop " << accumulator << endl;
			if (op == "+") out << "\tadd " << accumulator << ", " << secondary << endl;
			else if (op == "-") out << "\tsub " << accumulator << ", " << secondary << endl;
			else if (op == "*") out << "\timul " << accumulator << ", " << secondary << endl;
			else if (op == "&") out << "\tand " << accumulator << ", " << secondary << endl;
			else if (op == "|") out << "\tor " << accumulator << ", " << secondary << endl;
			else if (op == "^") out << "\txor " << accumulator << ", " << secondary << endl;
			else
			{
				if (bit16) out << "\tcwd" << endl;
				else if (bit32) out << "\tcdq" << endl;
				else out << "\tcqo" << endl;
				out << "\tidiv " << secondary << endl;
				if (op == "%") out << "\tmov " << accumulator << ", " << asmHighRegister() << endl;
			}
			return true;
		}
	}

	if (data->getType() == NT_UNARY && data->hasExp1() && data->getExp1())
	{
		if (!emitMasmExpression(out, data->getExp1()->getTree())) return false;
		if (data->hasOp() && data->getOp())
		{
			const string op = asmOperatorText(data->getOp());
			if (op == "-") out << "\tneg " << accumulator << endl;
			else if (op == "~") out << "\tnot " << accumulator << endl;
		}
		return true;
	}

	return false;
}

string MasmCodeGenerator::vectorToCommaSeparatedList(const vector<string>& vec)
{
	string result;
	for (size_t i = 0; i < vec.size(); ++i)
	{
		result += vec[i];
		if (i < vec.size() - 1)
		{
			result += ", ";
		}
	}
	return result;
}

string MasmCodeGenerator::getAsmType(TokenType type, bool isPointer, bool isUnsigned)
{
	string asmType;
	if (isPointer)
	{
		if (bit16) asmType = "WORD ";
		else if (bit32) asmType = "DWORD ";
		else asmType = "QWORD ";
	}
	else if (!isUnsigned && type == CHAR) asmType = "SBYTE ";
	else if (!isUnsigned && type == BOOLT) asmType = "SBYTE ";
	else if (!isUnsigned && type == SHORTT) asmType = "SWORD ";
	else if (!isUnsigned && type == INT && bit16) asmType = "SWORD ";
	else if (!isUnsigned && type == INT && bit32) asmType = "SDWORD ";
	else if (!isUnsigned && type == INT && bit64) asmType = "SDWORD ";
	else if (!isUnsigned && type == LONG) asmType = "SDWORD ";
	else if (!isUnsigned && type == FLOAT) asmType = "SDWORD ";
	else if (!isUnsigned && type == LONG_LONG) asmType = "SQWORD ";
	else if (!isUnsigned && type == DOUBLE) asmType = "SQWORD ";
	else if (!isUnsigned && type == LONG_DOUBLE) asmType = "TBYTE ";
	else if (isUnsigned && type == CHAR) asmType = "BYTE ";
	else if (isUnsigned && type == BOOLT) asmType = "BYTE ";
	else if (isUnsigned && type == SHORTT) asmType = "WORD ";
	else if (isUnsigned && type == INT && bit16) asmType = "WORD ";
	else if (isUnsigned && type == INT && bit32) asmType = "DWORD ";
	else if (isUnsigned && type == INT && bit64) asmType = "DWORD ";
	else if (isUnsigned && type == LONG) asmType = "DWORD ";
	else if (isUnsigned && type == FLOAT) asmType = "DWORD ";
	else if (isUnsigned && type == LONG_LONG) asmType = "QWORD ";
	else if (isUnsigned && type == DOUBLE) asmType = "QWORD ";
	else if (isUnsigned && type == LONG_DOUBLE) asmType = "TBYTE ";
	return asmType;
}

void MasmCodeGenerator::handleFunctionWithParameters(ostream& out, string name, shared_ptr<vector<shared_ptr<VariableData>>> list)
{
	vector<string> paramList;
	for (shared_ptr<VariableData> ptr : *list)
	{
		optional<TokenType> type = ptr->type;
		auto variableName = "_" + ptr->name;
		bool isInitialized = ptr->initializer != nullptr;
		bool isPointer = ptr->pointer;
		bool isArray = ptr->arraySize > 1;
		bool isStruct = type == STRUCT || type == UNION;
		bool isUnsigned = ptr->unsign == true;

		string asmType = getAsmType(type.value(), isPointer, isUnsigned);
		paramList.push_back(variableName + ":" + asmType);
	}
	string paramListStr = vectorToCommaSeparatedList(paramList);
	out << "_" << name << " PROC C, " << paramListStr << endl;
}

void MasmCodeGenerator::handleIndividualFunctionStatements(ostream& out, TokenType returnType, shared_ptr<BaseStatement> statements)
{
	if (!statements || !statements->getStatementList()) return;

	for (const auto& node : *statements->getStatementList())
	{
		if (!node) continue;
		if (node->getOp() == expression_statement)
		{
			auto baseStatement = node->getStatement();
			auto expression = baseStatement ? baseStatement->getExp() : nullptr;
			if (!expression || !expression->hasTree() || !expression->getData()) continue;

			if (expression->getData()->getType() == NT_FUNCTION_CALL)
			{
				auto parameters = expression->getData()->getArgumentList();
				auto callee = expression->getLeft();
				if (!callee || !callee->hasData() || !callee->getData()->hasToken3()) continue;
				string functionName = callee->getData()->getToken3()->getSymbolName();
				vector<string> arguments;
				if (parameters != nullptr)
				{
					for (const auto& argument : *parameters)
					{
						string value = to_string(argument->getData()->getConstant()->getIConst()->getIntegerConst());
						arguments.push_back(value);
					}
					out << "\tinvoke _" << functionName << ", " << vectorToCommaSeparatedList(arguments) << endl;
				}
				else
				{
					out << "\tinvoke _" << functionName << endl;
				}
			}
			else
			{
				emitMasmExpression(out, expression->getTree());
			}
		}
		else if (node->getOp() == jump_statement)
		{
			auto baseStatement = node->getStatement();
			if (!baseStatement || !baseStatement->getOp()) continue;
			if (baseStatement->getOp().value() == RETURN)
			{
				auto expression = baseStatement->getExp();
				if (expression && expression->hasTree()) emitMasmExpression(out, expression->getTree());
				out << "\tret" << endl;
			}
		}
	}
}

void MasmCodeGenerator::handleIndividualFunction(ostream& out, shared_ptr<FunctionData> ptr)
{
	optional<TokenType> returnType = ptr->type;
	shared_ptr<vector<shared_ptr<VariableData>>> parameters = ptr->parameters;
	shared_ptr<BaseStatement> statements = ptr->statements;
	// emit PROC and LOCAL/parameter declarations
	if (parameters != nullptr && !parameters->empty())
	{
		handleFunctionWithParameters(out, ptr->name, parameters);
	}
	else
	{
		out << "_" << ptr->name << " PROC C" << endl;
	}

	// emit LOCAL directive for locals, MASM syntax: LOCAL name:TYPE, ...
	if (ptr->localVariables && !ptr->localVariables->empty())
	{
		vector<string> localDecls;
		for (auto& lv : *ptr->localVariables)
		{
			bool isPointer = lv->pointer;
			bool isUnsigned = lv->unsign;
			string asmType = getAsmType(lv->type.value_or(UNKNOWN), isPointer, isUnsigned);
			string lname = lv->name;
			// MASM LOCAL expects the type without trailing space sometimes; use trimmed
			if (!asmType.empty())
			{
				// remove trailing space
				if (asmType.back() == ' ') asmType.pop_back();
			}
			localDecls.push_back("_" + lname + ":" + asmType);
		}
		if (!localDecls.empty())
		{
			out << "\tLOCAL " << vectorToCommaSeparatedList(localDecls) << endl;
		}
	}

	handleIndividualFunctionStatements(out, returnType.value(), statements);

	out << "_" << ptr->name << " endp" << endl;
}

string MasmCodeGenerator::convertToAsmType(bool isUnsigned, bool isPointer, TokenType type)
{
	string asmType = "";
	if (isPointer)
	{
		if (bit16) asmType = " WORD ";
		else if (bit32) asmType = " DWORD ";
		else asmType = " QWORD ";
	}
	else if (!isUnsigned && type == CHAR) asmType = " SBYTE ";
	else if (!isUnsigned && type == BOOLT) asmType = " SBYTE ";
	else if (!isUnsigned && type == SHORTT) asmType = " SWORD ";
	else if (!isUnsigned && type == INT) asmType = " SDWORD ";
	else if (!isUnsigned && type == LONG) asmType = " SDWORD ";
	else if (!isUnsigned && type == LONG_LONG) asmType = " SQWORD ";
	else if (!isUnsigned && type == FLOAT) asmType = " REAL4 ";
	else if (!isUnsigned && type == DOUBLE) asmType = " REAL8 ";
	else if (!isUnsigned && type == LONG_DOUBLE) asmType = " REAL10 ";
	else if (isUnsigned && type == CHAR) asmType = " BYTE ";
	else if (isUnsigned && type == BOOLT) asmType = " BYTE ";
	else if (isUnsigned && type == SHORTT) asmType = " WORD ";
	else if (isUnsigned && type == INT) asmType = " DWORD ";
	else if (isUnsigned && type == LONG) asmType = " DWORD ";
	else if (isUnsigned && type == LONG_LONG) asmType = " QWORD ";
	else if (isUnsigned && type == FLOAT) asmType = " REAL4 ";
	else if (isUnsigned && type == DOUBLE) asmType = " REAL8 ";
	else if (isUnsigned && type == LONG_DOUBLE) asmType = " REAL10 ";
	return asmType;
}

void MasmCodeGenerator::outputVariable(ostream& out, shared_ptr<VariableData> ptr)
{
	auto type = ptr->type;
	auto variableName = "_" + ptr->name;
	bool isInitialized = ptr->initializer != nullptr;
	bool isPointer = ptr->pointer;
	bool isArray = ptr->arraySize > 1;
	bool isStruct = type == STRUCT || type == UNION;
	bool isUnsigned = ptr->unsign == true;

	string asmType = convertToAsmType(isUnsigned, isPointer, type.value());

	if (!isInitialized)
	{
		if (!isPointer)
		{
			if (isStruct && !isArray)
			{
				string structName = ptr->structName;
				out << variableName << " " << structName << " <>" << endl;
			}
			else if (!isStruct && isArray)
			{
				out << variableName << asmType << ptr->arraySize << " dup(?)" << endl;
			}
			else if (isStruct && isArray)
			{
				shared_ptr<StructOrUnionSpecifier> suSpec = ptr->suSpec;
				auto structName = suSpec->getName()->getSymbolName();
				out << variableName << " " << structName << " " << ptr->arraySize << " dup(<>)" << endl;
			}
			else
			{
				out << variableName << asmType << " ?" << endl;
			}
		}
		else
		{
			out << variableName << asmType << " ?" << endl;
		}
	}
	else
	{
		auto constant = ptr->initializer->getAssignmentExpression()->getData()->getConstant();
		if (constant->getIConst() != nullptr)
		{
			long long int value = constant->getIConst()->getIntegerConst();
			out << variableName << asmType << value << endl;
		}
		if (constant->getFConst() != nullptr)
		{
			long double value = constant->getFConst()->getDoubleConst();
			out << variableName << asmType << (long double)value << endl;
		}
	}
}

void MasmCodeGenerator::handleInitializedVariable(ostream& out, shared_ptr<VariableData> ptr)
{
	if (ptr->initializer != nullptr && ptr->plist == nullptr)
	{
		outputVariable(out, ptr);
	}
}

void MasmCodeGenerator::handleUUninitializedVariable(ostream& out, shared_ptr<VariableData> ptr)
{
	if (ptr->initializer == nullptr && ptr->plist == nullptr)
	{
		outputVariable(out, ptr);
	}
}

void MasmCodeGenerator::handleVariableTable(ostream& out)
{
	out << ".data" << endl;
	for (shared_ptr<VariableData> ptr : *variableTable)
	{
		handleInitializedVariable(out, ptr);
	}
	out << ".data?" << endl;
	for (shared_ptr<VariableData> ptr : *variableTable)
	{
		handleUUninitializedVariable(out, ptr);
	}
}

void MasmCodeGenerator::handleFunctionTablePrototypes(ostream& out)
{
	for (shared_ptr<FunctionData> ptr : *functionTable)
	{
		optional<TokenType> returnType = ptr->type;
		shared_ptr<vector<shared_ptr<VariableData>>> parameters = ptr->parameters;
		string name = "_" + ptr->name;
		vector<string> paramList;
		if (parameters != nullptr)
		{
			for (shared_ptr<VariableData> ptr : *parameters)
			{
				optional<TokenType> type = ptr->type;
				string variableName = "_" + ptr->name;
				bool isInitialized = ptr->initializer != nullptr;
				bool isPointer = ptr->pointer;
				bool isArray = ptr->arraySize > 1;
				bool isStruct = type == STRUCT || type == UNION;
				bool isUnsigned = ptr->unsign == true;

				string asmType = getAsmType(type.value(), isPointer, isUnsigned);
				paramList.push_back(variableName + ":" + asmType);
			}
			string paramListStr = vectorToCommaSeparatedList(paramList);
			out << name << " PROTO C " << paramListStr << ";" << endl;
		}
		else
		{
			out << name << " PROTO C;" << endl;
		}
	}
}

void MasmCodeGenerator::handleFunctionTable(ostream& out)
{
	out << endl << ".code" << endl;
	handleFunctionTablePrototypes(out);
	for (shared_ptr<FunctionData> ptr : *functionTable)
	{
		out << endl;
		handleIndividualFunction(out, ptr);
	}
}

void MasmCodeGenerator::handleStructs(ostream& out)
{
	shared_ptr<map<string, shared_ptr<StructOrUnionSpecifier>>> temp = compiler->getStructList();
	for (map<string, shared_ptr<StructOrUnionSpecifier>>::iterator iterator = temp->begin(); iterator != temp->end(); ++iterator)
	{
		string key = iterator->first;
		shared_ptr<StructOrUnionSpecifier> value = iterator->second;
		shared_ptr<StructOrUnionSpecifier> suSpec = value;
		string name = suSpec->getName()->getSymbolName();
		shared_ptr<vector<shared_ptr<StructDeclaration>>> vars = suSpec->getVectorStructDeclaration();
		out << name << (value->getStructOrUnion()->getKeywordName()=="struct" ? " STRUCT" : " UNION") << endl;
		for (shared_ptr<StructDeclaration> var : *vars)
		{
			TokenType type = var->getSpecifierQualifierList()->getTypeSpecifier()->getType().value();
			shared_ptr<vector<shared_ptr<StructDeclarator>>> structDecl = var->getVectorStructDeclarator();
			for (shared_ptr<StructDeclarator> decl : *structDecl)
			{
				auto varName = decl->getDeclarator()->getDirectDeclarator()->getIdentifier()->getSymbolName();
				if (type == CHAR || type == BOOLT) out << "\t" << varName << " SBYTE ?" << endl;
				else if (type == SHORTT) out << "\t" << varName << " SWORD ?" << endl;
				else if (type == INT) out << "\t" << varName << " SDWORD ?" << endl;
				else if (type == LONG) out << "\t" << varName << " SDWORD ?" << endl;
				else if (type == LONG_LONG) out << "\t" << varName << " SQWORD ?" << endl;
				else if (type == FLOAT) out << "\t" << varName << " REAL4 ?" << endl;
				else if (type == DOUBLE) out << "\t" << varName << " REAL8 ?" << endl;
				else if (type == LONG_DOUBLE) out << "\t" << varName << " REAL10 ?" << endl;
			}
		}
		out << name << " ENDS" << endl;

	}
}

void MasmCodeGenerator::handlePrototype(ostream& out)
{
	for (shared_ptr<VariableData> ptr : *variableTable)
	{
		if (ptr->plist != nullptr)
		{
			vector<string> paramList;
			for (shared_ptr<ParameterDeclaration> node : *ptr->plist->getVectorParameterDeclaration())
			{
				shared_ptr<DeclarationSpecifiers> temp1 = node->getDeclarationSpecifiers();
				shared_ptr<Declarator> temp2 = node->getDeclarator();
				shared_ptr<vector<shared_ptr<DeclarationSpecifiersNode>>> temp3 = temp1->getDeclarationSpecifiersNodeList();

				auto name = temp2->getDirectDeclarator()->getIdentifier()->getSymbolName();
				bool isUnsigned = false;
				TokenType type = UNKNOWN;
				bool isPointer = temp2->hasPointer();

				for (shared_ptr<DeclarationSpecifiersNode> node2 : *temp3)
				{
					TokenType temp = node2->getTypeSpecifier()->getType().value();
					if (temp == CHAR || temp == BOOLT) type = temp;
					else if (temp == SHORTT) type = temp;
					else if (temp == INT) type = temp;
					else if (temp == LONG) type = temp;
					else if (temp == LONG_LONG) type = temp;
					else if (temp == FLOAT) type = temp;
					else if (temp == DOUBLE) type = temp;
					else if (temp == LONG_DOUBLE)  type = temp;
					else if (temp == UNSIGNED) isUnsigned = true;
					else if (temp == SIGNED) isUnsigned = false;
				}
				if (type != UNKNOWN)
				{
					string asmType = convertToAsmType(isUnsigned, isPointer, type);
					paramList.push_back(name + ":" + asmType);
				}
			}
			auto name = "_" + ptr->name;
			string paramListStr = vectorToCommaSeparatedList(paramList);
			//vector<string>::iterator it = find(compiler->getFunctionList()->begin(), compiler->getFunctionList()->end(), name);
			//if (it == compiler->getFunctionList()->end()) 
				out << "EXTERN " << name << " :PROTO " << paramListStr << ";" << endl;
		}
	}
}

void MasmCodeGenerator::generateCode(ostream& out)
{
	if (bit16)
	{
		out << ".386" << endl;
		out << ".model small;" << endl;
		out << "OPTION SEGMENT:USE16" << endl;
	}
	else if (bit32)
	{
		out << ".386" << endl;
		out << ".model flat, c;" << endl;
	}
	else
	{
		out << ".x64p" << endl;
		//out << ".model flat, c;" << endl;
	}
	out << "option casemap : none" << endl;
	out << endl;
	handlePrototype(out);
	out << endl;
	handleStructs(out);
	out << endl;
	handleVariableTable(out);
	handleFunctionTable(out);
	out << "end" << endl << endl;;
}

