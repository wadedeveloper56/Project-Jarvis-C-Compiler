name: CI

on:
  push:
  pull_request:

jobs:
  build-windows:
    runs-on: windows-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install vcpkg
        run: |
          git clone https://github.com/microsoft/vcpkg.git vcpkg
          .\vcpkg\bootstrap-vcpkg.bat

      - name: Restore vcpkg packages (manifest)
        shell: pwsh
        run: |
          $vcpkgRoot = Join-Path $PWD 'vcpkg'
          Write-Host "Using vcpkg root: $vcpkgRoot"
          .\scripts\restore-vcpkg.ps1 -VcpkgRoot $vcpkgRoot -Triplet x64-windows

      - name: Build tests (Debug|x64)
        shell: cmd
        run: |
          msbuild.exe source\Tools\JWcc2\tests\JWcc2.Tests.vcxproj /p:Configuration=Debug /p:Platform=x64 /p:OutDir=%CD%\\artifacts\\tests\\Debug\\x64\\

      - name: Run tests
        shell: cmd
        run: |
          artifacts\\tests\\Debug\\x64\\JWcc2.Tests.exe
