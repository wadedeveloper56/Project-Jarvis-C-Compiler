#include "pch.h"
#include "codeview_pdb.h"

using namespace std;

namespace JWlink2::codeview
{
	using Bytes = vector<uint8_t>;
	constexpr uint32_t BlockSize = 4096;
	constexpr uint32_t CvSignatureC13 = 4;
	constexpr uint32_t DebugSLines = 0xF2;
	constexpr uint32_t DebugSStringTable = 0xF3;
	constexpr uint32_t DebugSFileChecksums = 0xF4;
	constexpr uint16_t S_PUB32 = 0x110E;
	constexpr uint32_t PdbVersion = 20000404;
	constexpr uint32_t DbiVersion = 19990903;
	constexpr uint32_t TpiVersion = 20040203;
	constexpr uint32_t SectionContributionVersion = 0xF12EBA2D;
	constexpr uint32_t NoStream = 0xFFFF;

	[[noreturn]] void fail(const string& message)
	{
		throw runtime_error("CodeView/PDB: " + message);
	}

	template <typename T>
	void appendLe(Bytes& out, T value)
	{
		static_assert(is_unsigned_v<T>);
		for (size_t i = 0; i < sizeof(T); ++i)
		{
			out.push_back(static_cast<uint8_t>(value >> (i * 8)));
		}
	}

	template <typename T>
	void putLe(Bytes& out, size_t offset, T value)
	{
		static_assert(is_unsigned_v<T>);
		if (offset > out.size() || sizeof(T) > out.size() - offset)
		{
			fail("internal serialization range error");
		}
		for (size_t i = 0; i < sizeof(T); ++i)
		{
			out[offset + i] = static_cast<uint8_t>(value >> (i * 8));
		}
	}

	template <typename T>
	T readLe(const Bytes& data, size_t offset, string_view what)
	{
		static_assert(is_unsigned_v<T>);
		if (offset > data.size() || sizeof(T) > data.size() - offset)
		{
			fail("truncated " + string(what));
		}
		T result = 0;
		for (size_t i = 0; i < sizeof(T); ++i)
		{
			result |= static_cast<T>(data[offset + i]) << (i * 8);
		}
		return result;
	}

	uint32_t toU32(size_t value, string_view what)
	{
		if (value > numeric_limits<uint32_t>::max())
		{
			fail(string(what) + " exceeds the PDB 32-bit size limit");
		}
		return static_cast<uint32_t>(value);
	}

	uint32_t checkedAdd(uint32_t a, uint32_t b, string_view what)
	{
		if (b > numeric_limits<uint32_t>::max() - a)
		{
			fail(string(what) + " overflows");
		}
		return a + b;
	}

	size_t align4(size_t value)
	{
		if (value > numeric_limits<size_t>::max() - 3)
		{
			fail("input size overflow");
		}
		return (value + 3) & ~size_t(3);
	}

	void appendString(Bytes& out, const string& value)
	{
		if (value.find('\0') != string::npos)
		{
			fail("names cannot contain embedded NUL bytes");
		}
		out.insert(out.end(), value.begin(), value.end());
		out.push_back(0);
	}

	void validateRecord(const Bytes& record, string_view what)
	{
		if (record.size() < 4 || record.size() > numeric_limits<uint16_t>::max() + size_t(2))
		{
			fail(string(what) + " has an invalid record size");
		}
		if (readLe<uint16_t>(record, 0, what) != record.size() - 2)
		{
			fail(string(what) + " length does not match its byte array");
		}
	}

	void padCodeViewRecord(Bytes& record, string_view what)
	{
		const auto padding = align4(record.size()) - record.size();
		if (padding == 0)
		{
			return;
		}
		if (record.size() + padding - 2 > numeric_limits<uint16_t>::max())
		{
			fail(string(what) + " is too large after alignment");
		}
		for (size_t i = padding; i != 0; --i)
		{
			record.push_back(static_cast<uint8_t>(0xF0 + i));
		}
		putLe(record, 0, static_cast<uint16_t>(record.size() - 2));
	}

	struct TypeKey
	{
		string objectId;
		uint32_t index = 0;
		bool operator==(const TypeKey& rhs) const { return objectId == rhs.objectId && index == rhs.index; }
	};

	struct TypeKeyHash
	{
		size_t operator()(const TypeKey& key) const
		{
			const auto a = hash<string>{}(key.objectId);
			const auto b = hash<uint32_t>{}(key.index);
			return a ^ (b + 0x9E3779B9U + (a << 6) + (a >> 2));
		}
	};

	struct ModuleOutput
	{
		string moduleName;
		string objectName;
		Bytes symbolRecords;
		Bytes c13;
		vector<Bytes> contributions;
		vector<string> files;
		uint32_t symbolBytes = 0;
		uint32_t c13Bytes = 0;
		uint16_t streamIndex = 0;
	};

	Bytes normalizeType(const CodeViewTypeRecord& type,
		const string& objectId,
		const unordered_map<TypeKey, uint32_t, TypeKeyHash>& typeMap)
	{
		Bytes record = type.record;
		validateRecord(record, "type record");
		for (const auto& patch : type.references)
		{
			if (patch.offset > record.size() || 4 > record.size() - patch.offset)
			{
				fail("type-index patch is outside its record");
			}
			const auto oldIndex = readLe<uint32_t>(record, patch.offset, "type index");
			if (oldIndex < 0x1000)
			{
				continue;
			}
			const auto mapped = typeMap.find(TypeKey{ objectId, oldIndex });
			if (mapped == typeMap.end())
			{
				fail("type record refers to an unmapped object type index");
			}
			putLe(record, patch.offset, mapped->second);
		}
		padCodeViewRecord(record, "type record");
		return record;
	}

	const ObjectSectionContribution& mapContribution(const CodeViewObject& object, uint16_t section, uint32_t offset)
	{
		const ObjectSectionContribution* match = nullptr;
		for (const auto& contribution : object.contributions)
		{
			if (contribution.sourceSection != section)
			{
				continue;
			}
			const auto end = static_cast<uint64_t>(contribution.sourceOffset) + contribution.size;
			if (offset >= contribution.sourceOffset && offset < end)
			{
				if (match != nullptr)
				{
					fail("ambiguous object-section contribution mapping");
				}
				match = &contribution;
			}
		}
		if (match == nullptr || match->linkedSection == 0)
		{
			fail("CodeView address has no retained linked-section contribution");
		}
		return *match;
	}

	uint32_t remapOffset(const CodeViewObject& object, uint16_t section, uint32_t offset)
	{
		const auto& contribution = mapContribution(object, section, offset);
		const auto delta = offset - contribution.sourceOffset;
		if (delta > contribution.size)
		{
			fail("CodeView address lies outside its contribution");
		}
		return checkedAdd(contribution.linkedOffset, delta, "remapped CodeView address");
	}

	Bytes normalizeSymbol(const CodeViewObject& object,
		const CodeViewSymbolRecord& input,
		const unordered_map<TypeKey, uint32_t, TypeKeyHash>& typeMap)
	{
		Bytes record = input.record;
		validateRecord(record, "symbol record");
		for (const auto& patch : input.typeReferences)
		{
			if (patch.offset > record.size() || 4 > record.size() - patch.offset)
			{
				fail("symbol type-index patch is outside its record");
			}
			const auto oldIndex = readLe<uint32_t>(record, patch.offset, "symbol type index");
			if (oldIndex < 0x1000)
			{
				continue;
			}
			const auto mapped = typeMap.find(TypeKey{ object.objectId, oldIndex });
			if (mapped == typeMap.end())
			{
				fail("symbol refers to an unmapped object type index");
			}
			putLe(record, patch.offset, mapped->second);
		}
		for (const auto& patch : input.addresses)
		{
			if (patch.offsetField > record.size() || 4 > record.size() - patch.offsetField ||
				patch.sectionField > record.size() || 2 > record.size() - patch.sectionField)
			{
				fail("symbol address patch is outside its record");
			}
			const auto oldOffset = readLe<uint32_t>(record, patch.offsetField, "symbol section offset");
			const auto& contribution = mapContribution(object, input.sourceSection, oldOffset);
			putLe(record, patch.offsetField, remapOffset(object, input.sourceSection, oldOffset));
			putLe(record, patch.sectionField, contribution.linkedSection);
		}
		padCodeViewRecord(record, "symbol record");
		return record;
	}

	void remapLines(const CodeViewObject& object, Bytes& data)
	{
		if (data.size() < 12)
		{
			fail("truncated DEBUG_S_LINES subsection");
		}
		const auto originalStart = readLe<uint32_t>(data, 0, "line subsection address");
		const auto originalSection = readLe<uint16_t>(data, 4, "line subsection section");
		const auto flags = readLe<uint16_t>(data, 6, "line subsection flags");
		const auto mappedStart = remapOffset(object, originalSection, originalStart);
		const auto& contribution = mapContribution(object, originalSection, originalStart);
		putLe(data, 0, mappedStart);
		putLe(data, 4, contribution.linkedSection);
		const auto end = readLe<uint32_t>(data, 8, "line subsection code size");
		if (static_cast<uint64_t>(originalStart) + end > numeric_limits<uint32_t>::max())
		{
			fail("line subsection address range overflows");
		}
		size_t cursor = 12;
		while (cursor < data.size())
		{
			if (data.size() - cursor < 12)
			{
				fail("truncated C13 line file block");
			}
			const auto lineCount = readLe<uint32_t>(data, cursor + 4, "line count");
			const auto blockSize = readLe<uint32_t>(data, cursor + 8, "line block size");
			if (blockSize < 12 || blockSize > data.size() - cursor)
			{
				fail("invalid C13 line file block size");
			}
			const uint64_t rowBytes = static_cast<uint64_t>(lineCount) * 8;
			const uint64_t columnBytes = (flags & 1) != 0 ? static_cast<uint64_t>(lineCount) * 4 : 0;
			if (12 + rowBytes + columnBytes > blockSize)
			{
				fail("C13 line block is shorter than its line and column records");
			}
			for (uint32_t i = 0; i < lineCount; ++i)
			{
				const auto offsetField = cursor + 12 + static_cast<size_t>(i) * 8;
				const auto oldOffset = readLe<uint32_t>(data, offsetField, "line address");
				putLe(data, offsetField, remapOffset(object, originalSection, oldOffset));
			}
			cursor += blockSize;
		}
	}

	uint32_t hashStringV1(string_view value)
	{
		uint32_t result = 0;
		size_t i = 0;
		for (; i + 4 <= value.size(); i += 4)
		{
			uint32_t word = 0;
			for (size_t b = 0; b < 4; ++b) word |= static_cast<uint32_t>(static_cast<uint8_t>(value[i + b])) << (b * 8);
			result ^= word;
		}
		if (value.size() - i >= 2)
		{
			result ^= static_cast<uint32_t>(static_cast<uint8_t>(value[i])) | (static_cast<uint32_t>(static_cast<uint8_t>(value[i + 1])) << 8);
			i += 2;
		}
		if (value.size() - i == 1)
		{
			result ^= static_cast<uint8_t>(value[i]);
		}
		result |= 0x20202020;
		result ^= result >> 11;
		return result ^ (result >> 16);
	}

	// Merges per-object DEBUG_S_STRINGTABLE data into the PDB-wide /names stream.
	class StringPool
	{
	public:
		StringPool() { buffer_.push_back(0); }

		uint32_t add(const string& value)
		{
			if (value.empty()) return 0;
			const auto found = offsets_.find(value);
			if (found != offsets_.end()) return found->second;
			const auto offset = toU32(buffer_.size(), "PDB string table");
			appendString(buffer_, value);
			offsets_.emplace(value, offset);
			return offset;
		}

		Bytes serialize() const
		{
			Bytes result;
			appendLe(result, static_cast<uint32_t>(0xEFFEEFFE));
			appendLe(result, static_cast<uint32_t>(1));
			appendLe(result, toU32(buffer_.size(), "PDB string table"));
			result.insert(result.end(), buffer_.begin(), buffer_.end());
			const auto bucketCount = static_cast<uint32_t>(offsets_.size() * 2 + 1);
			vector<uint32_t> buckets(bucketCount, 0);
			for (const auto& [text, offset] : offsets_)
			{
				auto index = hashStringV1(text) % bucketCount;
				while (buckets[index] != 0) index = (index + 1) % bucketCount;
				buckets[index] = offset;
			}
			appendLe(result, bucketCount);
			for (const auto bucket : buckets) appendLe(result, bucket);
			appendLe(result, toU32(offsets_.size(), "PDB string count"));
			return result;
		}

	private:
		Bytes buffer_;
		map<string, uint32_t> offsets_;
	};

	string readObjectString(const Bytes& table, uint32_t offset)
	{
		if (offset >= table.size()) fail("file checksum refers outside the object string table");
		const auto end = find(table.begin() + offset, table.end(), uint8_t{ 0 });
		if (end == table.end()) fail("unterminated object string table entry");
		return string(table.begin() + offset, end);
	}

	void rebaseChecksums(Bytes& data, const Bytes& objectStrings, StringPool& pool, vector<string>& files)
	{
		size_t cursor = 0;
		while (cursor < data.size())
		{
			if (data.size() - cursor < 6) fail("truncated DEBUG_S_FILECHECKSUMS entry");
			const auto oldOffset = readLe<uint32_t>(data, cursor, "file checksum name offset");
			auto name = readObjectString(objectStrings, oldOffset);
			putLe(data, cursor, pool.add(name));
			files.push_back(move(name));
			const auto size = data[cursor + 4];
			const auto next = align4(cursor + 6 + size);
			if (next > data.size() && cursor + 6 + size > data.size()) fail("truncated DEBUG_S_FILECHECKSUMS entry");
			cursor = next;
		}
	}

	Bytes makeC13(const CodeViewObject& object, StringPool& pool, vector<string>& files)
	{
		Bytes result;
		Bytes objectStrings;
		for (const auto& subsection : object.subsections)
		{
			if (subsection.kind == DebugSStringTable) objectStrings = subsection.data;
		}
		for (const auto& subsection : object.subsections)
		{
			if (subsection.kind == DebugSStringTable) continue; // Replaced by the PDB /names stream.
			Bytes data = subsection.data;
			if (subsection.kind == DebugSLines)
			{
				remapLines(object, data);
			}
			else if (subsection.kind == DebugSFileChecksums)
			{
				rebaseChecksums(data, objectStrings, pool, files);
			}
			appendLe(result, subsection.kind);
			appendLe(result, toU32(data.size(), "CodeView subsection"));
			result.insert(result.end(), data.begin(), data.end());
			result.resize(align4(result.size()), 0);
		}
		return result;
	}

	Bytes makePublicSymbol(const LinkedSymbol& symbol)
	{
		if (symbol.name.empty())
		{
			fail("linked symbol name is empty");
		}
		Bytes record;
		appendLe(record, static_cast<uint16_t>(0));
		appendLe(record, S_PUB32);
		appendLe(record, symbol.flags);
		appendLe(record, symbol.offset);
		appendLe(record, symbol.section);
		appendString(record, symbol.name);
		if (record.size() - 2 > numeric_limits<uint16_t>::max())
		{
			fail("linked symbol name is too long for CodeView");
		}
		putLe(record, 0, static_cast<uint16_t>(record.size() - 2));
		padCodeViewRecord(record, "linked public symbol");
		return record;
	}

	Bytes makeModuleStream(const ModuleOutput& module)
	{
		Bytes stream;
		appendLe(stream, CvSignatureC13);
		stream.insert(stream.end(), module.symbolRecords.begin(), module.symbolRecords.end());
		stream.insert(stream.end(), module.c13.begin(), module.c13.end());
		appendLe(stream, static_cast<uint32_t>(0)); // Global references size.
		return stream;
	}

	Bytes makeModuleInfo(const vector<ModuleOutput>& modules)
	{
		Bytes result;
		for (size_t i = 0; i < modules.size(); ++i)
		{
			const auto& module = modules[i];
			appendLe(result, static_cast<uint32_t>(0)); // Unused.
			if (module.contributions.empty())
			{
				result.resize(result.size() + 28, 0);
			}
			else
			{
				result.insert(result.end(), module.contributions.front().begin(), module.contributions.front().end()); // First section contribution.
			}
			appendLe(result, static_cast<uint16_t>(0)); // Flags.
			appendLe(result, module.streamIndex);
			appendLe(result, module.symbolBytes);
			appendLe(result, static_cast<uint32_t>(0)); // C11 bytes.
			appendLe(result, module.c13Bytes);
			appendLe(result, static_cast<uint16_t>(module.files.size())); // Source file count.
			appendLe(result, static_cast<uint16_t>(0)); // Padding.
			appendLe(result, static_cast<uint32_t>(0)); // File-name offset.
			appendLe(result, static_cast<uint32_t>(0)); // Source file name index.
			appendLe(result, static_cast<uint32_t>(0)); // PDB file path name index.
			appendString(result, module.moduleName);
			appendString(result, module.objectName);
			result.resize(align4(result.size()), 0);
		}
		return result;
	}

	Bytes makeSectionContributions(const vector<ModuleOutput>& modules)
	{
		vector<const Bytes*> ordered;
		for (const auto& module : modules)
		{
			for (const auto& contribution : module.contributions) ordered.push_back(&contribution);
		}
		// Readers binary-search this table by (section, offset).
		stable_sort(ordered.begin(), ordered.end(), [](const Bytes* a, const Bytes* b)
			{
				const auto sectionA = readLe<uint16_t>(*a, 0, "contribution section");
				const auto sectionB = readLe<uint16_t>(*b, 0, "contribution section");
				if (sectionA != sectionB) return sectionA < sectionB;
				return readLe<uint32_t>(*a, 4, "contribution offset") < readLe<uint32_t>(*b, 4, "contribution offset");
			});
		Bytes result;
		appendLe(result, SectionContributionVersion);
		for (const auto* contribution : ordered)
		{
			result.insert(result.end(), contribution->begin(), contribution->end());
		}
		return result;
	}

	Bytes makeSectionMap(const vector<LinkedSection>& sections)
	{
		Bytes result;
		appendLe(result, static_cast<uint16_t>(sections.size()));
		appendLe(result, static_cast<uint16_t>(sections.size()));
		for (const auto& section : sections)
		{
			appendLe(result, static_cast<uint16_t>(0)); // Flags.
			appendLe(result, static_cast<uint16_t>(0)); // Overlay.
			appendLe(result, static_cast<uint16_t>(0)); // Group.
			appendLe(result, section.index);
			appendLe(result, static_cast<uint16_t>(0)); // Section-name string index.
			appendLe(result, static_cast<uint16_t>(0)); // Class-name string index.
			appendLe(result, static_cast<uint32_t>(0));
			appendLe(result, section.size);
		}
		return result;
	}

	Bytes makeFileInfo(const vector<ModuleOutput>& modules)
	{
		Bytes result;
		size_t total = 0;
		for (const auto& module : modules) total += module.files.size();
		if (total > numeric_limits<uint16_t>::max()) fail("too many source files for DBI file info");
		appendLe(result, static_cast<uint16_t>(modules.size()));
		appendLe(result, static_cast<uint16_t>(total));
		for (size_t i = 0; i < modules.size(); ++i)
		{
			appendLe(result, static_cast<uint16_t>(i));
		}
		for (const auto& module : modules)
		{
			appendLe(result, static_cast<uint16_t>(module.files.size()));
		}
		Bytes nameBuffer;
		map<string, uint32_t> nameOffsets;
		for (const auto& module : modules)
		{
			for (const auto& file : module.files)
			{
				const auto [found, inserted] = nameOffsets.emplace(file, toU32(nameBuffer.size(), "DBI file name buffer"));
				if (inserted) appendString(nameBuffer, file);
				appendLe(result, found->second);
			}
		}
		result.insert(result.end(), nameBuffer.begin(), nameBuffer.end());
		result.resize(align4(result.size()), 0);
		return result;
	}

	struct DbiStreams
	{
		uint16_t global = NoStream;
		uint16_t publics = NoStream;
		uint16_t symbolRecords = NoStream;
		uint16_t sectionHeaders = NoStream;
	};

	Bytes makeDbi(const PdbIdentity& identity,
		const vector<ModuleOutput>& modules,
		const vector<LinkedSection>& sections,
		const DbiStreams& streams)
	{
		Bytes optionalHeader;
		for (uint16_t i = 0; i < 11; ++i)
		{
			appendLe(optionalHeader, i == 5 ? streams.sectionHeaders : static_cast<uint16_t>(NoStream)); // Index 5 is the section-header stream.
		}
		const auto modInfo = makeModuleInfo(modules);
		const auto sectionContributions = makeSectionContributions(modules);
		const auto sectionMap = makeSectionMap(sections);
		const auto fileInfo = makeFileInfo(modules);
		Bytes result;
		appendLe(result, static_cast<uint32_t>(0xFFFFFFFF));
		appendLe(result, DbiVersion);
		appendLe(result, identity.age);
		appendLe(result, streams.global); // Global symbol hash stream.
		appendLe(result, static_cast<uint16_t>(0x8E0B)); // Build number 14.11 in the new-format encoding.
		appendLe(result, streams.publics); // Public symbol stream.
		appendLe(result, static_cast<uint16_t>(0)); // PDB DLL version.
		appendLe(result, streams.symbolRecords); // Symbol-record stream.
		appendLe(result, static_cast<uint16_t>(0)); // PDB DLL rebuild.
		appendLe(result, toU32(modInfo.size(), "DBI module info"));
		appendLe(result, toU32(sectionContributions.size(), "DBI section contributions"));
		appendLe(result, toU32(sectionMap.size(), "DBI section map"));
		appendLe(result, toU32(fileInfo.size(), "DBI file info"));
		appendLe(result, static_cast<uint32_t>(0)); // Type-server map.
		appendLe(result, static_cast<uint32_t>(0)); // MFC type-server index.
		appendLe(result, toU32(optionalHeader.size(), "DBI optional debug header"));
		appendLe(result, static_cast<uint32_t>(0)); // EC substream.
		appendLe(result, static_cast<uint16_t>(0)); // Flags.
		appendLe(result, static_cast<uint16_t>(0x8664)); // AMD64.
		appendLe(result, static_cast<uint32_t>(0));
		result.insert(result.end(), modInfo.begin(), modInfo.end());
		result.insert(result.end(), sectionContributions.begin(), sectionContributions.end());
		result.insert(result.end(), sectionMap.begin(), sectionMap.end());
		result.insert(result.end(), fileInfo.begin(), fileInfo.end());
		result.insert(result.end(), optionalHeader.begin(), optionalHeader.end());
		return result;
	}

	Bytes makeInfo(const PdbIdentity& identity, uint16_t namesStream)
	{
		Bytes result;
		appendLe(result, PdbVersion);
		appendLe(result, identity.signature);
		appendLe(result, identity.age);
		result.insert(result.end(), identity.guid.begin(), identity.guid.end());
		constexpr string_view namesKey = "/names";
		appendLe(result, static_cast<uint32_t>(namesKey.size() + 1)); // Named-stream string-buffer size.
		result.insert(result.end(), namesKey.begin(), namesKey.end());
		result.push_back(0);
		constexpr uint32_t capacity = 8;
		appendLe(result, static_cast<uint32_t>(1)); // Named-stream hash-table size.
		appendLe(result, capacity);
		appendLe(result, static_cast<uint32_t>(1)); // Present bitmap word count.
		appendLe(result, static_cast<uint32_t>(1U << (hashStringV1(namesKey) % capacity)));
		appendLe(result, static_cast<uint32_t>(0)); // Deleted bitmap word count.
		appendLe(result, static_cast<uint32_t>(0)); // Key: offset of "/names".
		appendLe(result, static_cast<uint32_t>(namesStream));
		appendLe(result, static_cast<uint32_t>(20140508)); // VC140 feature signature.
		return result;
	}

	struct PublicRecord
	{
		string name;
		uint32_t offset = 0; // Offset in the symbol-record stream.
	};

	// Builds a GSI hash section: header, hash records ordered by bucket, bucket bitmap and chain offsets.
	Bytes makeGsiHash(const vector<PublicRecord>& records)
	{
		constexpr uint32_t buckets = 4096;
		vector<vector<const PublicRecord*>> chains(buckets);
		for (const auto& record : records)
		{
			chains[hashStringV1(record.name) % buckets].push_back(&record);
		}
		Bytes hashRecords;
		vector<uint32_t> bitmap((buckets + 32) / 32, 0);
		Bytes chainOffsets;
		uint32_t recordIndex = 0;
		for (uint32_t bucket = 0; bucket < buckets; ++bucket)
		{
			if (chains[bucket].empty()) continue;
			bitmap[bucket / 32] |= 1U << (bucket % 32);
			appendLe(chainOffsets, recordIndex * 12);
			for (const auto* record : chains[bucket])
			{
				appendLe(hashRecords, record->offset + 1);
				appendLe(hashRecords, static_cast<uint32_t>(1));
				++recordIndex;
			}
		}
		Bytes result;
		appendLe(result, static_cast<uint32_t>(0xFFFFFFFF));
		appendLe(result, static_cast<uint32_t>(0xEFFE0000 + 19990810));
		appendLe(result, toU32(hashRecords.size(), "GSI hash records"));
		appendLe(result, toU32(bitmap.size() * 4 + chainOffsets.size(), "GSI buckets"));
		result.insert(result.end(), hashRecords.begin(), hashRecords.end());
		for (const auto word : bitmap) appendLe(result, word);
		result.insert(result.end(), chainOffsets.begin(), chainOffsets.end());
		return result;
	}

	Bytes makePublicsStream(const vector<PublicRecord>& records, const vector<uint32_t>& addressOrder, size_t sectionCount)
	{
		const auto hash = makeGsiHash(records);
		Bytes result;
		appendLe(result, toU32(hash.size(), "PSI hash"));
		appendLe(result, toU32(addressOrder.size() * 4, "PSI address map"));
		appendLe(result, static_cast<uint32_t>(0)); // Thunk count.
		appendLe(result, static_cast<uint32_t>(0)); // Thunk size.
		appendLe(result, static_cast<uint16_t>(0)); // Thunk section.
		appendLe(result, static_cast<uint16_t>(0));
		appendLe(result, static_cast<uint32_t>(0)); // Thunk offset.
		appendLe(result, toU32(sectionCount, "PSI section count"));
		result.insert(result.end(), hash.begin(), hash.end());
		for (const auto offset : addressOrder) appendLe(result, offset);
		return result;
	}

	Bytes makeSectionHeaders(const vector<LinkedSection>& sections)
	{
		Bytes result;
		for (const auto& section : sections)
		{
			array<uint8_t, 8> name{};
			copy_n(section.name.begin(), min<size_t>(8, section.name.size()), name.begin());
			result.insert(result.end(), name.begin(), name.end());
			appendLe(result, section.size);
			appendLe(result, section.rva);
			appendLe(result, section.size);
			for (int i = 0; i < 3; ++i) appendLe(result, static_cast<uint32_t>(0)); // Raw, relocation and line pointers.
			appendLe(result, static_cast<uint32_t>(0)); // Relocation and line counts.
			appendLe(result, section.characteristics);
		}
		return result;
	}

	Bytes makeTpi(const vector<Bytes>& records)
	{
		Bytes recordBytes;
		for (const auto& record : records)
		{
			recordBytes.insert(recordBytes.end(), record.begin(), record.end());
		}
		Bytes result;
		appendLe(result, TpiVersion);
		appendLe(result, static_cast<uint32_t>(56));
		appendLe(result, static_cast<uint32_t>(0x1000));
		appendLe(result, checkedAdd(0x1000, toU32(records.size(), "TPI record count"), "TPI end index"));
		appendLe(result, toU32(recordBytes.size(), "TPI records"));
		appendLe(result, static_cast<uint16_t>(NoStream));
		appendLe(result, static_cast<uint16_t>(NoStream));
		appendLe(result, static_cast<uint32_t>(4));
		appendLe(result, static_cast<uint32_t>(0x3FFFF));
		appendLe(result, static_cast<uint32_t>(0));
		appendLe(result, static_cast<uint32_t>(0));
		appendLe(result, static_cast<uint32_t>(0));
		appendLe(result, static_cast<uint32_t>(0));
		appendLe(result, static_cast<uint32_t>(0));
		appendLe(result, static_cast<uint32_t>(0));
		result.insert(result.end(), recordBytes.begin(), recordBytes.end());
		return result;
	}

	struct MsfStream
	{
		Bytes bytes;
		vector<uint32_t> blocks;
	};

	Bytes makeMsf(vector<Bytes> streams)
	{
		vector<MsfStream> allocated;
		allocated.reserve(streams.size());
		uint64_t nextBlock = 3;
		for (auto& bytes : streams)
		{
			MsfStream stream;
			stream.bytes = move(bytes);
			const auto count = (stream.bytes.size() + BlockSize - 1) / BlockSize;
			if (nextBlock + count > 32768)
			{
				fail("MSF 7.0 output exceeds the single free-page-map range limit");
			}
			for (size_t i = 0; i < count; ++i)
			{
				stream.blocks.push_back(static_cast<uint32_t>(nextBlock++));
			}
			allocated.push_back(move(stream));
		}
		Bytes directory;
		appendLe(directory, toU32(allocated.size(), "MSF stream count"));
		for (const auto& stream : allocated)
		{
			appendLe(directory, stream.bytes.empty() ? static_cast<uint32_t>(0xFFFFFFFF) : toU32(stream.bytes.size(), "MSF stream"));
		}
		for (const auto& stream : allocated)
		{
			for (const auto block : stream.blocks)
			{
				appendLe(directory, block);
			}
		}
		const auto directoryBlockCount = (directory.size() + BlockSize - 1) / BlockSize;
		if (directoryBlockCount == 0 || directoryBlockCount > BlockSize / sizeof(uint32_t))
		{
			fail("MSF stream directory exceeds the block-map capacity");
		}
		vector<uint32_t> directoryBlocks;
		for (size_t i = 0; i < directoryBlockCount; ++i)
		{
			directoryBlocks.push_back(static_cast<uint32_t>(nextBlock++));
		}
		const auto blockMapBlock = static_cast<uint32_t>(nextBlock++);
		if (nextBlock > 32768)
		{
			fail("MSF 7.0 output exceeds the single free-page-map range limit");
		}
		Bytes file(static_cast<size_t>(nextBlock) * BlockSize, 0);
		static constexpr array<uint8_t, 32> magic = {
			'M','i','c','r','o','s','o','f','t',' ','C','/','C','+','+',' ','M','S','F',' ','7','.','0','0','\r','\n',0x1A,'D','S',0,0,0
		};
		copy(magic.begin(), magic.end(), file.begin());
		Bytes super;
		appendLe(super, BlockSize);
		appendLe(super, static_cast<uint32_t>(1));
		appendLe(super, static_cast<uint32_t>(nextBlock));
		appendLe(super, toU32(directory.size(), "MSF directory"));
		appendLe(super, static_cast<uint32_t>(0));
		appendLe(super, blockMapBlock);
		copy(super.begin(), super.end(), file.begin() + 32);

		Bytes fpm(BlockSize, 0xFF);
		for (uint32_t block = 0; block < nextBlock; ++block)
		{
			fpm[block / 8] &= static_cast<uint8_t>(~(1U << (block % 8)));
		}
		copy(fpm.begin(), fpm.end(), file.begin() + BlockSize);
		copy(fpm.begin(), fpm.end(), file.begin() + 2 * BlockSize);

		for (const auto& stream : allocated)
		{
			size_t offset = 0;
			for (const auto block : stream.blocks)
			{
				const auto count = min<size_t>(BlockSize, stream.bytes.size() - offset);
				copy_n(stream.bytes.begin() + static_cast<ptrdiff_t>(offset), count,
					file.begin() + static_cast<ptrdiff_t>(block) * BlockSize);
				offset += count;
			}
		}
		for (size_t i = 0; i < directoryBlocks.size(); ++i)
		{
			const auto offset = i * BlockSize;
			const auto count = min<size_t>(BlockSize, directory.size() - offset);
			copy_n(directory.begin() + static_cast<ptrdiff_t>(offset), count,
				file.begin() + static_cast<ptrdiff_t>(directoryBlocks[i]) * BlockSize);
			putLe(file, static_cast<size_t>(blockMapBlock) * BlockSize + i * 4, directoryBlocks[i]);
		}
		return file;
	}

	PdbBuilder::PdbBuilder(PdbIdentity identity) : identity_(identity)
	{
		if (identity_.age == 0)
		{
			fail("PDB age must be nonzero");
		}
	}

	void PdbBuilder::addLinkedSection(LinkedSection section)
	{
		if (section.index == 0 || section.name.empty())
		{
			fail("linked sections require a nonzero PE index and name");
		}
		if (any_of(sections_.begin(), sections_.end(), [&](const auto& item) { return item.index == section.index; }))
		{
			fail("duplicate linked section index");
		}
		sections_.push_back(move(section));
	}

	void PdbBuilder::addLinkedSymbol(LinkedSymbol symbol)
	{
		if (symbol.name.empty() || symbol.section == 0)
		{
			fail("linked symbols require a name and a nonzero PE section");
		}
		symbols_.push_back(move(symbol));
	}

	void PdbBuilder::addCodeViewObject(CodeViewObject object)
	{
		if (object.objectId.empty())
		{
			fail("CodeView object identifier cannot be empty");
		}
		if (any_of(objects_.begin(), objects_.end(), [&](const auto& item) { return item.objectId == object.objectId; }))
		{
			fail("duplicate CodeView object identifier");
		}
		objects_.push_back(move(object));
	}

	void PdbBuilder::write(const filesystem::path& path) const
	{
		vector<LinkedSection> sections = sections_;
		sort(sections.begin(), sections.end(), [](const auto& a, const auto& b) { return a.index < b.index; });
		if (sections.size() > numeric_limits<uint16_t>::max())
		{
			fail("too many linked sections for DBI");
		}
		unordered_map<uint16_t, const LinkedSection*> sectionByIndex;
		for (size_t i = 0; i < sections.size(); ++i)
		{
			if (sections[i].index != i + 1)
			{
				fail("linked section indices must be contiguous and one-based");
			}
			sectionByIndex.emplace(sections[i].index, &sections[i]);
		}
		for (const auto& symbol : symbols_)
		{
			const auto found = sectionByIndex.find(symbol.section);
			if (found == sectionByIndex.end() || symbol.offset > found->second->size)
			{
				fail("linked symbol is outside the supplied linked sections");
			}
		}

		unordered_map<TypeKey, uint32_t, TypeKeyHash> typeMap;
		uint32_t nextType = 0x1000;
		for (const auto& object : objects_)
		{
			for (const auto& type : object.types)
			{
				if (type.originalIndex < 0x1000)
				{
					fail("object type record index is below the CodeView non-primitive range");
				}
				if (!typeMap.emplace(TypeKey{ object.objectId, type.originalIndex }, nextType).second)
				{
					fail("duplicate type index in one CodeView object");
				}
				if (nextType == numeric_limits<uint32_t>::max())
				{
					fail("too many CodeView type records");
				}
				++nextType;
			}
		}

		vector<Bytes> typeRecords;
		typeRecords.reserve(typeMap.size());
		for (const auto& object : objects_)
		{
			for (const auto& type : object.types)
			{
				typeRecords.push_back(normalizeType(type, object.objectId, typeMap));
			}
		}

		vector<ModuleOutput> modules;
		StringPool names;
		Bytes symbolRecordStream;
		vector<PublicRecord> globalRefs;
		vector<pair<uint16_t, pair<uint32_t, uint32_t>>> publicsByAddress; // (section, (offset, record offset))
		vector<PublicRecord> publics;
		modules.reserve(objects_.size() + (symbols_.empty() ? 0 : 1));
		for (const auto& object : objects_)
		{
			ModuleOutput module;
			module.moduleName = object.moduleName.empty() ? object.objectId : object.moduleName;
			module.objectName = object.objectFileName.empty() ? module.moduleName : object.objectFileName;
			for (const auto& symbol : object.symbols)
			{
				const auto normalized = normalizeSymbol(object, symbol, typeMap);
				const auto kind = readLe<uint16_t>(normalized, 2, "symbol kind");
				const auto moduleOffset = toU32(4 + module.symbolRecords.size(), "module symbol offset");
				string name;
				uint16_t refKind = 0;
				size_t nameOffset = 0;
				if (kind == 0x1110 || kind == 0x1147) { refKind = 0x1125; nameOffset = 39; }      // S_GPROC32 / S_GPROC32_ID -> S_PROCREF
				else if (kind == 0x110F || kind == 0x1146) { refKind = 0x1127; nameOffset = 39; } // S_LPROC32 / S_LPROC32_ID -> S_LPROCREF
				else if (kind == 0x110D) { refKind = 0x1126; nameOffset = 14; }                  // S_GDATA32 -> S_DATAREF
				if (refKind != 0)
				{
					if (nameOffset >= normalized.size()) fail("symbol record is too short for its name");
					const auto end = find(normalized.begin() + static_cast<ptrdiff_t>(nameOffset), normalized.end(), uint8_t{ 0 });
					name.assign(normalized.begin() + static_cast<ptrdiff_t>(nameOffset), end);
					Bytes ref;
					appendLe(ref, static_cast<uint16_t>(0));
					appendLe(ref, refKind);
					appendLe(ref, static_cast<uint32_t>(0));
					appendLe(ref, moduleOffset);
					appendLe(ref, static_cast<uint16_t>(modules.size() + 1));
					appendString(ref, name);
					padCodeViewRecord(ref, "symbol reference");
					putLe(ref, 0, static_cast<uint16_t>(ref.size() - 2));
					globalRefs.push_back({ name, toU32(symbolRecordStream.size(), "symbol record stream") });
					symbolRecordStream.insert(symbolRecordStream.end(), ref.begin(), ref.end());
				}
				module.symbolRecords.insert(module.symbolRecords.end(), normalized.begin(), normalized.end());
			}
			module.c13 = makeC13(object, names, module.files);
			for (const auto& source : object.contributions)
			{
				const auto found = sectionByIndex.find(source.linkedSection);
				if (source.sourceSection == 0 || found == sectionByIndex.end())
				{
					fail("object contribution refers to an unknown linked section");
				}
				const auto outputEnd = static_cast<uint64_t>(source.linkedOffset) + source.size;
				if (outputEnd > found->second->size)
				{
					fail("object contribution exceeds its linked section");
				}
				Bytes contribution;
				appendLe(contribution, source.linkedSection);
				appendLe(contribution, static_cast<uint16_t>(0));
				appendLe(contribution, source.linkedOffset);
				appendLe(contribution, source.size);
				appendLe(contribution, found->second->characteristics);
				appendLe(contribution, static_cast<uint16_t>(modules.size() + 1));
				appendLe(contribution, static_cast<uint16_t>(0));
				appendLe(contribution, static_cast<uint32_t>(0));
				appendLe(contribution, static_cast<uint32_t>(0));
				module.contributions.push_back(move(contribution));
			}
			module.symbolBytes = toU32(4 + module.symbolRecords.size(), "module symbol records");
			module.c13Bytes = toU32(module.c13.size(), "module C13 data");
			modules.push_back(move(module));
		}
		if (!symbols_.empty())
		{
			ModuleOutput generated;
			generated.moduleName = "JWlink2 linked symbols";
			generated.objectName = generated.moduleName;
			for (const auto& symbol : symbols_)
			{
				auto adjusted = symbol;
				const auto section = sectionByIndex.at(symbol.section);
				if ((section->characteristics & 0x20000000) != 0) adjusted.flags |= 2; // cvpsfFunction
				const auto record = makePublicSymbol(adjusted);
				publics.push_back({ adjusted.name, toU32(symbolRecordStream.size(), "symbol record stream") });
				publicsByAddress.push_back({ adjusted.section, { adjusted.offset, publics.back().offset } });
				symbolRecordStream.insert(symbolRecordStream.end(), record.begin(), record.end());
				generated.symbolRecords.insert(generated.symbolRecords.end(), record.begin(), record.end());
			}
			generated.symbolBytes = toU32(4 + generated.symbolRecords.size(), "generated symbol records");
			modules.push_back(move(generated));
		}
		constexpr size_t fixedStreams = 10;
		if (modules.size() + fixedStreams > NoStream)
		{
			fail("too many PDB module streams");
		}
		for (size_t i = 0; i < modules.size(); ++i)
		{
			modules[i].streamIndex = static_cast<uint16_t>(fixedStreams + i);
		}

		sort(publicsByAddress.begin(), publicsByAddress.end());
		vector<uint32_t> addressOrder;
		for (const auto& entry : publicsByAddress) addressOrder.push_back(entry.second.second);

		DbiStreams dbiStreams;
		dbiStreams.global = 6;
		dbiStreams.publics = 7;
		dbiStreams.symbolRecords = 8;
		dbiStreams.sectionHeaders = 9;

		vector<Bytes> streams;
		streams.reserve(fixedStreams + modules.size());
		streams.emplace_back(); // MSF directory is stream zero.
		streams.push_back(makeInfo(identity_, 5));
		streams.push_back(makeTpi(typeRecords));
		streams.push_back(makeDbi(identity_, modules, sections, dbiStreams));
		streams.push_back(makeTpi({})); // Empty IPI stream with a valid TPI header.
		streams.push_back(names.serialize());
		streams.push_back(makeGsiHash(globalRefs));
		streams.push_back(makePublicsStream(publics, addressOrder, sections.size()));
		streams.push_back(symbolRecordStream);
		streams.push_back(makeSectionHeaders(sections));		for (const auto& module : modules)
		{
			streams.push_back(makeModuleStream(module));
		}
		const auto file = makeMsf(move(streams));
		ofstream output(path, ios::binary | ios::trunc);
		if (!output)
		{
			fail("cannot open output file: " + path.string());
		}
		output.write(reinterpret_cast<const char*>(file.data()), static_cast<streamsize>(file.size()));
		if (!output)
		{
			fail("failed writing output file: " + path.string());
		}
	}

