			assertSuccess(runLinker(workspace, { L"/DLL", L"/DEF:" + workspace.file(L"module.def").wstring(), L"/OUT:" + workspace.file(L"custom.dll").wstring(), workspace.file(L"dll.obj").wstring() }));
